  snippets/focus-trap.liquid — Kwispelbox KB-v4
  Globale helper voor toegankelijke overlays. Gebruik:
    var trap = window.kbTrap(containerEl, openerEl);
    trap.on();   // vangt Tab in de container, zet focus op eerste element
    trap.off();  // stopt de trap en geeft focus terug aan de opener
{%- endcomment -%}
<script>
  window.kbTrap = function (container, opener) {
    var SEL = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
    function nodes() {
      return Array.prototype.filter.call(container.querySelectorAll(SEL), function (el) {
        return el.offsetWidth > 0 || el.offsetHeight > 0 || el === document.activeElement;
      });
    }
    function onKey(e) {
      if (e.key !== 'Tab') { return; }
      var f = nodes();
      if (!f.length) { return; }
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
    return {
      on: function () {
        container.addEventListener('keydown', onKey);
        var f = nodes();
        if (f.length) { f[0].focus(); }
      },
      off: function () {
        container.removeEventListener('keydown', onKey);
        if (opener && typeof opener.focus === 'function') { opener.focus(); }
      }
    };
  };
</script>
