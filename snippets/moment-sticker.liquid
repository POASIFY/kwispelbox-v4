      <rect x="16" y="31" width="32" height="22" rx="2.5" fill="#FFE071" stroke="#3d2209" stroke-width="2.4"/>
      <rect x="12.5" y="24" width="39" height="9.5" rx="2.5" fill="#F7A048" stroke="#3d2209" stroke-width="2.4"/>
