      <rect x="29.5" y="19" width="5" height="14" rx="2" fill="#ffffff" stroke="#3d2209" stroke-width="2.2"/>
      <path d="M32 9c3.2 3.4 3.2 7.6 0 9-3.2-1.4-3.2-5.6 0-9z" fill="#F7A048" stroke="#3d2209" stroke-width="2" stroke-linejoin="round"/>
