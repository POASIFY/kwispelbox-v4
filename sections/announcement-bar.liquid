{%- comment -%}
  sections/announcement-bar.liquid — Kwispelbox KB-v4
  Bruine aankondigingsbalk boven de header.
  Desktop: berichten naast elkaar. Mobiel: CSS marquee.
{%- endcomment -%}

{%- assign msg_blocks = section.blocks | where: 'type', 'message' -%}

{%- if msg_blocks.size > 0 -%}
<div class="ann-bar" role="region" aria-label="Aankondigingen"
     style="--ann-bg: {{ section.settings.bg_color }}; --ann-fg: {{ section.settings.text_color }};">

  <ul class="ann-bar__list" role="list">
    {%- for block in msg_blocks -%}
      <li class="ann-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="ann-bar__icon" aria-hidden="true">
            {{- block.settings.icon | inline_asset_content -}}
          </span>
        {%- endif -%}
        <span class="ann-bar__text">
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>

  <div class="ann-bar__marquee-wrap" aria-hidden="true">
    <div class="ann-bar__marquee">
      <div class="ann-bar__track">
        {%- for i in (1..2) -%}
          {%- for block in msg_blocks -%}
            <span class="ann-bar__marquee-item">
              {%- if block.settings.icon != blank -%}
                <span class="ann-bar__icon" aria-hidden="true">
                  {{- block.settings.icon | inline_asset_content -}}
                </span>
              {%- endif -%}
              {{ block.settings.text }}
              <span class="ann-bar__sep" aria-hidden="true">·</span>
            </span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

</div>
{%- endif -%}

{% stylesheet %}

.ann-bar {
  background: var(--ann-bg, #3d2209);
  color: var(--ann-fg, #FBF6EE);
  font-family: var(--font-body);
  font-size: .82rem;
  font-weight: 700;
}

.ann-bar__list {
  display: none;
  list-style: none;
  margin: 0 auto;
  padding: 0 var(--page-margin);
  max-width: var(--page-width);
}

.ann-bar__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 10px 16px;
  border-right: 1px solid rgba(255, 255, 255, .16);
  white-space: nowrap;
}

.ann-bar__item:last-child { border-right: none; }

.ann-bar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--ann-fg, #FBF6EE);
}

.ann-bar__icon svg { width: 17px; height: 17px; }

.ann-bar__text { color: var(--ann-fg, #FBF6EE); }
.ann-bar__text a { color: var(--ann-fg, #FBF6EE); text-decoration: none; }
.ann-bar__text a:hover { text-decoration: underline; }

.ann-bar__marquee-wrap {
  display: none;
  overflow: hidden;
  padding: 8px 0;
  mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
}

.ann-bar__marquee { display: flex; width: 100%; overflow: hidden; }

.ann-bar__track {
  display: flex;
  align-items: center;
  white-space: nowrap;
  animation: ann-scroll 28s linear infinite;
}

.ann-bar__marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 0 14px;
}

.ann-bar__sep { opacity: .5; margin-left: 4px; }

@keyframes ann-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .ann-bar__track { animation: none; }
}

@media (max-width: 749px) {
  .ann-bar__marquee-wrap { display: flex; }
}

@media (min-width: 750px) {
  .ann-bar__list { display: flex; }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Aankondigingsbalk",
  "tag": "aside",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Achtergrondkleur", "default": "#3d2209" },
    { "type": "color", "id": "text_color", "label": "Tekst- en icoonkleur", "default": "#FBF6EE" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Bericht",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst", "default": "Gratis verzending vanaf €50" },
        { "type": "url", "id": "link", "label": "Link (optioneel)" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "default": "icon-truck.svg",
          "options": [
            { "value": "icon-truck.svg", "label": "Vrachtwagen" },
            { "value": "icon-clock.svg", "label": "Klok" },
            { "value": "icon-gift.svg", "label": "Cadeau" },
            { "value": "icon-heart.svg", "label": "Hart" },
            { "value": "icon-mail.svg", "label": "Envelop" },
            { "value": "icon-star.svg", "label": "Ster" },
            { "value": "icon-paw.svg", "label": "Poot" },
            { "value": "icon-check-circle.svg", "label": "Vinkje" },
            { "value": "icon-shield.svg", "label": "Schild" },
            { "value": "", "label": "Geen icoon" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aankondigingsbalk",
      "blocks": [
        { "type": "message", "settings": { "text": "Gratis verzending vanaf €50", "icon": "icon-truck.svg" } },
        { "type": "message", "settings": { "text": "Voor 16:00 besteld, morgen in huis", "icon": "icon-clock.svg" } },
        { "type": "message", "settings": { "text": "Met een persoonlijk kaartje", "icon": "icon-gift.svg" } }
      ]
    }
  ]
}
{% endschema %}
