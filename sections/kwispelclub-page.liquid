{%- comment -%}
  sections/kwispelclub-page.liquid — Kwispelbox KB-v4 · Kwispelclub (premium coming-soon)
  ------------------------------------------------------------------------------------------
  EERLIJKE coming-soon club-pagina. De loyalty-engine bestaat nog NIET:
  geen saldo, geen tiers, geen earning/redemption, geen referral, geen fake social proof.
  Alle copy is toekomstgericht ("binnenkort", "straks", "zodra de club opent").
  Nieuwsbrief/waitlist = echte Shopify {% form 'customer' %} met tags newsletter, kwispelclub.
  Prefix: kc / kc-.
{%- endcomment -%}

{%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
{%- assign steps    = section.blocks | where: 'type', 'step' -%}
{%- assign chips    = section.blocks | where: 'type', 'chip' -%}
{%- assign links    = section.blocks | where: 'type', 'link' -%}

<div class="kc full-width">
  {%- if section.settings.show_decorations -%}
    <div class="kc__deco" aria-hidden="true">
      <span class="kc__deco-item kc__deco--paw">{%- render 'lucide', icon: 'paw' -%}</span>
      <span class="kc__deco-item kc__deco--heart">{%- render 'lucide', icon: 'heart' -%}</span>
      <span class="kc__deco-item kc__deco--spark">{%- render 'lucide', icon: 'sparkles' -%}</span>
    </div>
  {%- endif -%}

  <div class="kc__inner">

    {%- comment -%} ── HERO ─────────────────────────────── {%- endcomment -%}
    <section class="kc-hero">
      <div class="kc-hero__text">
        {%- if section.settings.hero_eyebrow != blank -%}
          <span class="kc-eyebrow"><span class="kc-eyebrow__icon" aria-hidden="true">{%- render 'lucide', icon: 'crown' -%}</span>{{ section.settings.hero_eyebrow }}</span>
        {%- endif -%}
        <h1 class="kc-hero__title">{{ section.settings.hero_title_1 }}{% if section.settings.hero_title_2 != blank %} <span class="kc-hero__title-em">{{ section.settings.hero_title_2 }}</span>{% endif %}</h1>
        {%- if section.settings.hero_body != blank -%}<p class="kc-hero__body">{{ section.settings.hero_body }}</p>{%- endif -%}
        <div class="kc-hero__actions">
          {%- if section.settings.hero_cta1 != blank -%}
            <a href="#kc-waitlist" class="kc-btn kc-btn--primary">{{ section.settings.hero_cta1 }}<span class="kc-btn__arw" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a>
          {%- endif -%}
          {%- if section.settings.hero_cta2 != blank -%}
            <a href="#kc-benefits" class="kc-btn kc-btn--ghost">{{ section.settings.hero_cta2 }}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="kc-hero__visual">
        <div class="kc-hero__stage">
          {%- if section.settings.hero_image != blank -%}
            {{ section.settings.hero_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,900,1200', sizes: '(max-width: 989px) 92vw, 46vw', alt: section.settings.hero_image.alt | default: 'Kwispelclub', class: 'kc-hero__img' }}
          {%- else -%}
            <div class="kc-hero__fallback">
              <span class="kc-hero__glyph" aria-hidden="true">{%- render 'lucide', icon: 'dog' -%}</span>
              <div class="kc-card" aria-hidden="true">
                <span class="kc-card__paw">{%- render 'lucide', icon: 'paw' -%}</span>
                <span class="kc-card__name">{{ section.settings.card_name | default: 'Kwispelclub' }}</span>
                <span class="kc-card__tag">{{ section.settings.card_tag | default: 'Voor blije honden' }}</span>
              </div>
            </div>
          {%- endif -%}

          {%- if chips.size > 0 -%}
            <div class="kc-hero__chips">
              {%- for block in chips limit: 4 -%}
                <span class="kc-chip" {{ block.shopify_attributes }}><span class="kc-chip__icon" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>{{ block.settings.label }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </section>

    {%- comment -%} ── BENEFITS ─────────────────────────── {%- endcomment -%}
    {%- if benefits.size > 0 -%}
      <section class="kc-benefits kc-anchor" id="kc-benefits">
        {%- if section.settings.benefits_title != blank -%}<h2 class="kc-h2">{{ section.settings.benefits_title }}</h2>{%- endif -%}
        <div class="kc-benefits__grid">
          {%- for block in benefits -%}
            <article class="kc-benefit kc-benefit--{{ block.settings.color }}" {{ block.shopify_attributes }}>
              <span class="kc-benefit__icon" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>
              <h3 class="kc-benefit__title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p class="kc-benefit__text">{{ block.settings.text }}</p>{%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ── SPOTLIGHT ────────────────────────── {%- endcomment -%}
    {%- if section.settings.spot_title != blank -%}
      <section class="kc-spot">
        <figure class="kc-spot__media">
          {%- if section.settings.spot_image != blank -%}
            {{ section.settings.spot_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320,480,640', sizes: '(max-width: 859px) 80vw, 320px', alt: section.settings.spot_image.alt | default: section.settings.spot_title, class: 'kc-spot__img' }}
          {%- else -%}
            <div class="kc-spot__img kc-spot__img--ph">{%- render 'lucide', icon: 'camera' -%}</div>
          {%- endif -%}
          {%- if section.settings.spot_badge != blank -%}<figcaption class="kc-spot__badge">{{ section.settings.spot_badge }}</figcaption>{%- endif -%}
        </figure>
        <div class="kc-spot__body">
          {%- if section.settings.spot_eyebrow != blank -%}<span class="kc-eyebrow kc-eyebrow--pink"><span class="kc-eyebrow__icon" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>{{ section.settings.spot_eyebrow }}</span>{%- endif -%}
          <h2 class="kc-spot__title">{{ section.settings.spot_title }}</h2>
          {%- if section.settings.spot_text != blank -%}<p class="kc-spot__text">{{ section.settings.spot_text }}</p>{%- endif -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ── ZO WERKT HET STRAKS ──────────────── {%- endcomment -%}
    {%- if steps.size > 0 -%}
      <section class="kc-steps">
        {%- if section.settings.steps_title != blank -%}<h2 class="kc-h2">{{ section.settings.steps_title }}</h2>{%- endif -%}
        <ol class="kc-steps__list">
          {%- for block in steps -%}
            <li class="kc-step" {{ block.shopify_attributes }}>
              <span class="kc-step__num">{{ forloop.index }}</span>
              <div class="kc-step__body">
                <strong class="kc-step__title">{{ block.settings.title }}</strong>
                {%- if block.settings.text != blank -%}<span class="kc-step__text">{{ block.settings.text }}</span>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </section>
    {%- endif -%}

    {%- comment -%} ── WAITLIST (primaire conversie) ────── {%- endcomment -%}
    {%- if section.settings.news_title != blank -%}
      <section class="kc-wait kc-anchor" id="kc-waitlist">
        <div class="kc-wait__intro">
          <span class="kc-wait__icon" aria-hidden="true">{%- render 'lucide', icon: 'mail' -%}</span>
          <div>
            <strong class="kc-wait__title">{{ section.settings.news_title }}</strong>
            {%- if section.settings.news_text != blank -%}<p class="kc-wait__text">{{ section.settings.news_text }}</p>{%- endif -%}
          </div>
        </div>
        <div class="kc-wait__form">
          {%- form 'customer' -%}
            {%- if form.posted_successfully? -%}
              <p class="kc-wait__success"><span aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>{{ section.settings.news_success | default: 'Gelukt — je staat op de lijst! We laten je weten zodra de Kwispelclub opent.' }}</p>
            {%- else -%}
              <input type="hidden" name="contact[tags]" value="newsletter, kwispelclub">
              <div class="kc-wait__field">
                <input type="email" name="contact[email]" placeholder="{{ section.settings.news_placeholder | default: 'Jouw e-mailadres' }}" aria-label="E-mailadres" required>
                <button type="submit" class="kc-btn kc-btn--primary">{{ section.settings.news_button_label | default: 'Hou me op de hoogte' }}</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ── COMMUNITY BRIDGE ─────────────────── {%- endcomment -%}
    {%- if section.settings.bridge_title != blank -%}
      <section class="kc-bridge">
        {%- if section.settings.bridge_eyebrow != blank -%}<span class="kc-eyebrow"><span class="kc-eyebrow__icon" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>{{ section.settings.bridge_eyebrow }}</span>{%- endif -%}
        <h2 class="kc-bridge__title">{{ section.settings.bridge_title }}</h2>
        {%- if section.settings.bridge_text != blank -%}<p class="kc-bridge__text">{{ section.settings.bridge_text }}</p>{%- endif -%}
        <div class="kc-bridge__actions">
          {%- if section.settings.bridge_cta1 != blank -%}<a href="{{ section.settings.bridge_cta1_url | default: '/pages/community' }}" class="kc-btn kc-btn--primary">{{ section.settings.bridge_cta1 }}<span class="kc-btn__arw" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a>{%- endif -%}
          {%- if section.settings.bridge_cta2 != blank -%}<a href="{{ section.settings.bridge_cta2_url | default: '/collections/boxen' }}" class="kc-btn kc-btn--ghost">{{ section.settings.bridge_cta2 }}</a>{%- endif -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ── INTERNE LINKS ────────────────────── {%- endcomment -%}
    {%- if links.size > 0 -%}
      <div class="kc-links">
        {%- for block in links -%}
          <a class="kc-link" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="kc-link__icon" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>
            <span class="kc-link__body">
              <strong class="kc-link__title">{{ block.settings.label }}</strong>
              {%- if block.settings.text != blank -%}<span class="kc-link__text">{{ block.settings.text }}</span>{%- endif -%}
            </span>
            <span class="kc-link__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
/* ══ KWISPELCLUB · coming-soon sub-brand ══════════════════════════════════ */
.kc { position: relative; background: var(--color-cream); overflow: hidden; padding: clamp(28px, 4vw, 44px) 0 clamp(52px, 6vw, 76px); }
.kc::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(42% 34% at 10% 2%, rgba(231, 84, 128, .10), transparent 70%),
    radial-gradient(46% 40% at 98% 30%, rgba(102, 170, 68, .10), transparent 72%); }
.kc__inner { position: relative; z-index: 1; max-width: 1160px; margin: 0 auto; padding: 0 var(--page-margin); display: flex; flex-direction: column; gap: clamp(56px, 7vw, 80px); }

/* Doodles */
.kc__deco { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.kc__deco-item { position: absolute; display: block; opacity: .5; }
.kc__deco-item svg { width: 100%; height: 100%; }
.kc__deco--paw   { top: 24px; left: 3%;  width: 30px; height: 30px; color: var(--color-green); transform: rotate(-12deg); }
.kc__deco--heart { top: 54px; right: 4%; width: 26px; height: 26px; color: var(--color-pink); }
.kc__deco--spark { bottom: 40px; left: 6%; width: 26px; height: 26px; color: var(--color-yellow); }

/* Eyebrow */
.kc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-body); font-size: var(--fs-eyebrow); font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--color-green); margin-bottom: 12px; }
.kc-eyebrow--pink { color: var(--color-pink); }
.kc-eyebrow__icon { display: inline-flex; }
.kc-eyebrow__icon svg { width: 16px; height: 16px; }

/* Koppen */
.kc-h2 { font-family: var(--font-heading); font-size: var(--fs-h2); line-height: 1.05; color: var(--color-ink); text-align: center; margin: 0 0 clamp(22px, 3vw, 34px); }

/* Knoppen */
.kc-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 26px; border-radius: var(--radius-pill); font-family: var(--font-heading); font-size: 1.06rem; letter-spacing: var(--ls-button); text-decoration: none; border: 2px solid transparent; cursor: pointer; transition: transform 160ms, background 160ms, border-color 160ms, color 160ms, filter 160ms; }
.kc-btn--primary { background: var(--color-green); color: #fff; box-shadow: 0 12px 26px rgba(102,170,68,.26); }
.kc-btn--primary:hover { background: #5a9a3b; transform: translateY(-2px); }
.kc-btn--ghost { background: #fff; color: var(--color-ink); border-color: var(--color-line); }
.kc-btn--ghost:hover { border-color: var(--color-green); color: var(--color-green); transform: translateY(-2px); }
.kc-btn__arw svg { width: 18px; height: 18px; }

/* ── HERO ── */
.kc-hero { display: grid; grid-template-columns: 45fr 55fr; gap: clamp(24px, 4vw, 56px); align-items: center;
  background:
    radial-gradient(60% 80% at 10% 8%, #fde7f0, transparent 60%),
    radial-gradient(70% 90% at 96% 92%, #e8f5e2, transparent 62%),
    #fffaf2;
  border: 1.5px solid var(--color-line); border-radius: 32px; padding: clamp(24px, 3.4vw, 50px); }
.kc-hero__text { min-width: 0; }
.kc-hero__title { font-family: var(--font-heading); font-size: clamp(2.3rem, 5vw, 3.6rem); line-height: 1.02; color: var(--color-ink); margin: 0 0 16px; text-wrap: balance; }
.kc-hero__title-em { color: var(--color-green); display: inline-block; }
.kc-hero__body { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.6; color: var(--color-body); margin: 0 0 26px; max-width: 42ch; }
.kc-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }

.kc-hero__visual { min-width: 0; }
.kc-hero__stage { position: relative; }
.kc-hero__img { width: 100%; height: auto; display: block; border-radius: 24px; }
.kc-hero__fallback { position: relative; aspect-ratio: 1 / 0.82; border-radius: 24px; overflow: hidden;
  background: radial-gradient(70% 70% at 70% 30%, #eef7e8, #fff6ea 70%); display: flex; align-items: center; justify-content: center; }
.kc-hero__glyph { position: absolute; right: -6%; bottom: -6%; color: rgba(102,170,68,.18); }
.kc-hero__glyph svg { width: 68%; height: 68%; min-width: 220px; }
.kc-card { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; background: #d9efc8; border: 2px solid #fff; border-radius: 20px; padding: 26px 34px; box-shadow: 0 16px 36px rgba(61,34,9,.14); transform: rotate(-4deg); }
.kc-card__paw { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: #fff; color: var(--color-pink); margin-bottom: 2px; }
.kc-card__paw svg { width: 26px; height: 26px; }
.kc-card__name { font-family: var(--font-heading); font-size: 1.35rem; color: var(--color-ink); line-height: 1; }
.kc-card__tag { font-family: var(--font-body); font-size: .82rem; font-weight: 700; color: var(--color-green); }

/* Floating chips */
.kc-chip { display: inline-flex; align-items: center; gap: 7px; background: #fff; color: var(--color-ink); font-family: var(--font-body); font-weight: 700; font-size: .84rem; padding: 8px 14px; border-radius: var(--radius-pill); box-shadow: 0 8px 20px rgba(61,34,9,.12); white-space: nowrap; }
.kc-chip__icon { display: inline-flex; color: var(--color-pink); }
.kc-chip__icon svg { width: 15px; height: 15px; }
.kc-hero__chips { position: absolute; inset: 0; pointer-events: none; }
.kc-hero__chips .kc-chip { position: absolute; }
.kc-hero__chips .kc-chip:nth-child(1) { top: 4%; left: -2%; }
.kc-hero__chips .kc-chip:nth-child(1) .kc-chip__icon { color: var(--color-pink); }
.kc-hero__chips .kc-chip:nth-child(2) { top: 10%; right: -3%; }
.kc-hero__chips .kc-chip:nth-child(2) .kc-chip__icon { color: #d99100; }
.kc-hero__chips .kc-chip:nth-child(3) { bottom: 16%; right: -2%; }
.kc-hero__chips .kc-chip:nth-child(3) .kc-chip__icon { color: var(--color-orange); }
.kc-hero__chips .kc-chip:nth-child(4) { bottom: 6%; left: -1%; }
.kc-hero__chips .kc-chip:nth-child(4) .kc-chip__icon { color: var(--color-green); }

/* ── BENEFITS ── */
.kc-benefits__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.kc-benefit { --c: var(--color-pink); --c-soft: #fde7f0; background: var(--c-soft); border-radius: 26px; padding: clamp(20px, 2.2vw, 26px); display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.kc-benefit--pink   { --c: var(--color-pink);   --c-soft: #fde7f0; }
.kc-benefit--yellow { --c: #d99100;             --c-soft: #fdf3d2; }
.kc-benefit--orange { --c: var(--color-orange); --c-soft: #fde8d4; }
.kc-benefit--green  { --c: var(--color-green);  --c-soft: #e3f1d9; }
.kc-benefit__icon { display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; border-radius: 50%; background: #fff; color: var(--c); box-shadow: 0 5px 14px rgba(61,34,9,.07); }
.kc-benefit__icon svg { width: 25px; height: 25px; }
.kc-benefit__title { font-family: var(--font-heading); font-size: 1.14rem; line-height: 1.12; color: var(--color-ink); margin: 4px 0 0; }
.kc-benefit__text { font-family: var(--font-body); font-size: .9rem; line-height: 1.5; color: var(--color-body); margin: 0; }

/* ── SPOTLIGHT ── */
.kc-spot { display: grid; grid-template-columns: minmax(0, 300px) 1fr; gap: clamp(22px, 4vw, 48px); align-items: center; background: linear-gradient(130deg, #fde7f0, #fff3f7); border-radius: 28px; padding: clamp(22px, 3vw, 40px); }
.kc-spot__media { position: relative; margin: 0; background: #fff; padding: 12px 12px 16px; border-radius: 12px; box-shadow: 0 14px 34px rgba(61,34,9,.12); transform: rotate(-2deg); }
.kc-spot__img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 6px; display: block; }
.kc-spot__img--ph { display: flex; align-items: center; justify-content: center; background: linear-gradient(140deg, #fff, #fde7f0); color: var(--color-pink); }
.kc-spot__img--ph svg { width: 44px; height: 44px; }
.kc-spot__badge { position: absolute; top: 2px; right: 2px; background: var(--color-pink); color: #fff; font-family: var(--font-heading); font-size: .8rem; padding: 5px 12px; border-radius: var(--radius-pill); transform: rotate(4deg); box-shadow: var(--shadow-pop); }
.kc-spot__body { min-width: 0; }
.kc-spot__title { font-family: var(--font-heading); font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.08; color: var(--color-ink); margin: 0 0 10px; }
.kc-spot__text { font-family: var(--font-body); font-size: var(--fs-body); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 54ch; }

/* ── STEPS ── */
.kc-steps__list { counter-reset: none; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 3vw, 34px); position: relative; }
.kc-steps__list::before { content: ""; position: absolute; top: 26px; left: 16%; right: 16%; border-top: 2px dashed var(--color-line); z-index: 0; }
.kc-step { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; min-width: 0; }
.kc-step__num { display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 50%; background: #fff; border: 2px solid var(--color-green); color: var(--color-green); font-family: var(--font-heading); font-size: 1.5rem; }
.kc-step__body { min-width: 0; }
.kc-step__title { display: block; font-family: var(--font-heading); font-size: 1.12rem; color: var(--color-ink); margin-bottom: 4px; }
.kc-step__text { display: block; font-family: var(--font-body); font-size: .92rem; line-height: 1.5; color: var(--color-body); max-width: 30ch; margin: 0 auto; }

/* ── WAITLIST ── */
.kc-wait { display: grid; grid-template-columns: 1fr minmax(0, 420px); gap: clamp(20px, 3vw, 40px); align-items: center; background: linear-gradient(130deg, #e3f1d9, #eef7e8); border-radius: 28px; padding: clamp(24px, 3.2vw, 44px); scroll-margin-top: clamp(80px, 12vw, 130px); }
.kc-wait__intro { display: flex; align-items: center; gap: 16px; min-width: 0; }
.kc-wait__icon { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 58px; height: 58px; border-radius: 50%; background: #fff; color: var(--color-green); box-shadow: 0 8px 20px rgba(61,34,9,.08); }
.kc-wait__icon svg { width: 28px; height: 28px; }
.kc-wait__title { display: block; font-family: var(--font-heading); font-size: clamp(1.3rem, 2.4vw, 1.9rem); line-height: 1.1; color: var(--color-ink); }
.kc-wait__text { font-family: var(--font-body); font-size: var(--fs-body); line-height: 1.5; color: var(--color-body); margin: 6px 0 0; }
.kc-wait__field { display: flex; gap: 10px; }
.kc-wait__field input { flex: 1 1 auto; min-width: 0; min-height: 50px; padding: 0 18px; border: 1.5px solid var(--color-line); border-radius: var(--radius-pill); font-family: var(--font-body); font-size: 1rem; color: var(--color-ink); background: #fff; outline: none; transition: border-color 160ms; }
.kc-wait__field input:focus-visible { border-color: var(--color-green); }
.kc-wait__field .kc-btn { flex-shrink: 0; white-space: nowrap; }
.kc-wait__success { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-heading); font-size: 1.1rem; color: var(--color-green); margin: 0; }
.kc-wait__success svg { width: 22px; height: 22px; }

/* ── COMMUNITY BRIDGE ── */
.kc-bridge { text-align: center; max-width: 680px; margin: 0 auto; }
.kc-bridge .kc-eyebrow { justify-content: center; }
.kc-bridge__title { font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.3rem); line-height: 1.06; color: var(--color-ink); margin: 0 0 12px; }
.kc-bridge__text { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.6; color: var(--color-body); margin: 0 0 22px; }
.kc-bridge__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

/* ── INTERNE LINKS ── */
.kc-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 10px; }
.kc-link { --c: var(--color-green); --c-soft: #e8f5e2; display: flex; align-items: center; gap: 13px; background: transparent; border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: 13px 16px; text-decoration: none; min-width: 0; transition: background 160ms, border-color 160ms; }
.kc-link:hover { background: var(--c-soft); border-color: transparent; }
.kc-link__icon { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; background: var(--c-soft); color: var(--c); }
.kc-link:hover .kc-link__icon { background: #fff; }
.kc-link__icon svg { width: 19px; height: 19px; }
.kc-link__body { min-width: 0; display: flex; flex-direction: column; }
.kc-link__title { font-family: var(--font-heading); font-size: 1rem; color: var(--color-ink); }
.kc-link__text { font-family: var(--font-body); font-size: .84rem; color: var(--color-muted); }
.kc-link__chev { margin-left: auto; flex-shrink: 0; display: inline-flex; color: var(--color-muted); }
.kc-link__chev svg { width: 17px; height: 17px; }

/* ── Tablet ── */
@media (max-width: 989px) {
  .kc-hero { grid-template-columns: 1fr; text-align: center; }
  .kc-hero__body { margin-left: auto; margin-right: auto; }
  .kc-hero__actions { justify-content: center; }
  .kc-hero__visual { order: -1; max-width: 460px; margin: 0 auto; width: 100%; }
  .kc-benefits__grid { grid-template-columns: repeat(2, 1fr); }
}

/* ── Mobiel ── */
@media (max-width: 749px) {
  .kc__inner { gap: clamp(44px, 10vw, 56px); }
  .kc-benefits__grid { grid-template-columns: 1fr; gap: 12px; }
  .kc-benefit { flex-direction: row; align-items: flex-start; }
  .kc-benefit__icon { flex-shrink: 0; width: 44px; height: 44px; }
  .kc-benefit__icon svg { width: 22px; height: 22px; }
  .kc-spot { grid-template-columns: 1fr; gap: 18px; }
  .kc-spot__media { order: -1; max-width: 300px; margin: 0 auto; }
  .kc-steps__list { grid-template-columns: 1fr; gap: 0; }
  .kc-steps__list::before { top: 0; bottom: 0; left: 26px; right: auto; border-top: 0; border-left: 2px dashed var(--color-line); }
  .kc-step { flex-direction: row; align-items: flex-start; text-align: left; gap: 16px; padding: 10px 0; }
  .kc-step__num { flex-shrink: 0; width: 48px; height: 48px; font-size: 1.3rem; }
  .kc-step__text { margin: 0; max-width: none; }
  .kc-wait { grid-template-columns: 1fr; gap: 18px; }
  .kc-wait__field { flex-direction: column; }
  .kc-wait__field .kc-btn { width: 100%; }
  .kc-hero__actions .kc-btn, .kc-bridge__actions .kc-btn { width: 100%; }
  .kc__deco { display: none; }
  /* chips: niet meer absoluut zweven, maar nette rij onder de visual */
  .kc-hero__chips { position: static; inset: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; pointer-events: auto; }
  .kc-hero__chips .kc-chip { position: static; }
}

@media (prefers-reduced-motion: reduce) {
  .kc-btn, .kc-link { transition: none; }
  .kc-btn:hover, .kc-link:hover { transform: none; }
  .kc-card, .kc-spot__media { transform: none; }
}
{% endstylesheet %}

