{%- comment -%}
  sections/birthday-block.liquid — Kwispelbox KB-v4
  "Wanneer is jouw hond jarig?" — speelse gele banner met polaroid + klantformulier (form 'customer').
  Naam hond → contact[first_name], verjaardag → contact[note], e-mail → contact[email], vaste tag.
  Volgens docs/mockup-home.png.
{%- endcomment -%}

<section class="bd full-width">
  <div class="bd__inner">
    <div class="bd__card">
      <span class="bd__deco bd__deco--spark1" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>
      <span class="bd__deco bd__deco--spark2" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>
      <span class="bd__deco bd__deco--heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      <span class="bd__deco bd__deco--paw" aria-hidden="true">{%- render 'lucide', icon: 'paw' -%}</span>

      <div class="bd__media">
        <div class="bd__polaroid">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210,320,420', sizes: '210px', alt: section.settings.image.alt | default: 'Jarige hond', class: 'bd__polaroid-img' }}
          {%- else -%}
            <span class="bd__polaroid-img bd__polaroid-ph" aria-hidden="true">{%- render 'lucide', icon: 'dog' -%}</span>
          {%- endif -%}
        </div>
      </div>

      <div class="bd__content">
        <div class="bd__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="bd__eyebrow"><span class="bd__eyebrow-ic" aria-hidden="true">{%- render 'lucide', icon: 'bell' -%}</span>{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="bd__heading">{{ section.settings.heading }}<span class="bd__heading-cake" aria-hidden="true">{%- render 'moment-sticker', icon: 'cake' -%}</span></h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="bd__sub">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>

        <div class="bd__form-wrap">
          {%- form 'customer', class: 'bd__form' -%}
            <input type="hidden" name="contact[tags]" value="{{ section.settings.tag }}">
            {%- if form.posted_successfully? -%}
              <p class="bd__success">{{ section.settings.success_text }}</p>
            {%- else -%}
              <div class="bd__fields">
                <label class="bd__field">
                  <span class="bd__label">{{ section.settings.name_label }}</span>
                  <input type="text" name="contact[first_name]" placeholder="{{ section.settings.name_placeholder }}" autocomplete="off">
                </label>
                <label class="bd__field">
                  <span class="bd__label">{{ section.settings.date_label }}</span>
                  <input type="date" name="contact[note]">
                </label>
              </div>
              <div class="bd__submit-row">
                <label class="bd__field bd__field--email">
                  <input type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder }}" required autocomplete="email" aria-label="{{ section.settings.email_label }}">
                </label>
                <button type="submit" class="bd__btn">
                  <span class="bd__btn-icon" aria-hidden="true">{%- render 'lucide', icon: 'bell' -%}</span>
                  {{ section.settings.button_label }}
                </button>
              </div>
              {%- if form.errors -%}
                <p class="bd__error">{{ form.errors | default_errors }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.bd { background: transparent; }
.bd__inner { max-width: var(--page-width); margin: 0 auto; padding: clamp(14px, 2vw, 24px) var(--page-margin); }

/* Split-card: foto links (compact), content rechts. Zachte warme gradient i.p.v. een
   vlakke gele plaat; subtiele border + schaduw → "leuke reminder-card", niet "formulierplaat". */
.bd__card { position: relative; display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); align-items: center; gap: 30px; background: linear-gradient(120deg, #fff7db 0%, #ffe9a6 100%); border: 1px solid rgba(61,34,9,.06); border-radius: var(--radius-lg); padding: 22px 30px; box-shadow: 0 10px 30px rgba(61,34,9,.06); overflow: hidden; }

/* Foto-zone */
.bd__media { display: flex; justify-content: center; min-width: 0; }
.bd__polaroid { background: #fff; padding: 9px 9px 20px; border-radius: 8px; box-shadow: 0 12px 26px rgba(61,34,9,.16); transform: rotate(-4deg); }
.bd__polaroid-img { display: block; width: 210px; height: 158px; object-fit: cover; border-radius: 4px; }
.bd__polaroid-ph { display: flex; align-items: center; justify-content: center; background: #fff0f5; color: var(--color-pink); }
.bd__polaroid-ph .lucide { width: 46px; height: 46px; }

/* Content-zone */
.bd__content { min-width: 0; display: flex; flex-direction: column; gap: 14px; }
.bd__text { min-width: 0; }
.bd__eyebrow { display: inline-flex; align-items: center; gap: 7px; background: #fff; border-radius: var(--radius-pill); padding: 5px 13px; font-family: var(--font-body); font-size: .74rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #d9823a; box-shadow: 0 2px 8px rgba(61,34,9,.05); margin-bottom: 10px; }
.bd__eyebrow-ic { display: inline-flex; }
.bd__eyebrow-ic svg { width: 14px; height: 14px; }
.bd__heading { font-family: var(--font-heading); font-size: clamp(1.8rem, 2.9vw, 2.5rem); color: var(--color-ink); line-height: 1; margin: 0 0 6px; }
.bd__heading-cake { display: inline-block; vertical-align: middle; margin-left: 6px; }
.bd__heading-cake .mom-sticker { width: 34px; height: 34px; }
.bd__sub { font-family: var(--font-body); font-size: .95rem; font-weight: 600; color: var(--color-ink); margin: 0; max-width: 48ch; }

/* Formulier — compacter, premium */
.bd__form-wrap { min-width: 0; }
.bd__form { display: flex; flex-direction: column; gap: 9px; }
.bd__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.bd__field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.bd__label { font-family: var(--font-body); font-size: .72rem; font-weight: 700; letter-spacing: .02em; color: var(--color-body); }
.bd__field input { width: 100%; box-sizing: border-box; height: 44px; border: 1.5px solid rgba(61,34,9,.1); border-radius: 12px; padding: 0 13px; font-family: var(--font-body); font-size: .92rem; color: var(--color-ink); background: #fff; outline: none; transition: border-color 140ms, box-shadow 140ms; }
.bd__field input:focus { border-color: var(--color-green); box-shadow: 0 0 0 3px rgba(102,170,68,.12); }
.bd__field--email input::placeholder { color: var(--color-muted); }
.bd__submit-row { display: flex; gap: 10px; align-items: stretch; }
.bd__submit-row .bd__field--email { flex: 1; min-width: 0; }
.bd__submit-row .bd__field--email input { height: 48px; }
.bd__btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; flex-shrink: 0; height: 48px; padding: 0 26px; background: #e75480; color: #fff; border: none; border-radius: var(--radius-pill); font-family: var(--font-heading); font-size: 1.04rem; cursor: pointer; transition: background 140ms, transform 140ms; box-shadow: 0 8px 20px rgba(231,84,128,.26); }
.bd__btn:hover { background: #d64470; transform: translateY(-1px); }
.bd__btn-icon { display: inline-flex; }
.bd__btn-icon svg { width: 18px; height: 18px; }
.bd__success { font-family: var(--font-body); font-weight: 700; color: var(--color-green); background: #fff; border-radius: 12px; padding: 16px; margin: 0; }
.bd__error { font-family: var(--font-body); font-size: .82rem; color: #b3261e; margin: 0; }

/* Decoraties — subtiel, alleen rechtsboven */
.bd__deco { position: absolute; pointer-events: none; }
.bd__deco svg { width: 100%; height: 100%; }
.bd__deco--heart { top: 14px; right: 18px; width: 22px; color: #e75480; }
.bd__deco--heart svg { fill: none; stroke: currentColor; stroke-width: 2.2; }
.bd__deco--spark1 { top: 18px; right: 48px; width: 16px; color: var(--color-orange); }
.bd__deco--spark2, .bd__deco--paw { display: none; }

@media (max-width: 749px) {
  .bd__card { grid-template-columns: 1fr; gap: 14px; padding: 20px 18px; text-align: center; }
  .bd__polaroid { transform: rotate(-3deg); }
  .bd__polaroid-img { width: 150px; height: 112px; }
  .bd__content { gap: 12px; align-items: center; }
  .bd__eyebrow { align-self: center; }
  .bd__sub { max-width: none; }
  .bd__form { width: 100%; text-align: left; }
  .bd__submit-row { flex-direction: column; }
  .bd__submit-row .bd__field--email input { height: 48px; }
  .bd__btn { width: 100%; }
  .bd__deco--spark1 { display: none; }
}
@media (max-width: 400px) {
  .bd__fields { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Verjaardagsblok",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Polaroid-foto (hond)" },
    { "type": "text", "id": "eyebrow", "label": "Klein label boven de kop", "default": "Gratis verjaardagsreminder" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wanneer is jouw hond jarig?" },
    { "type": "text", "id": "text", "label": "Subtekst", "default": "Ontvang een reminder en leuke verjaardagtips!" },
    { "type": "header", "content": "Formulier" },
    { "type": "text", "id": "name_label", "label": "Label naam", "default": "Naam van je hond" },
    { "type": "text", "id": "name_placeholder", "label": "Placeholder naam", "default": "Bijv. Max" },
    { "type": "text", "id": "date_label", "label": "Label verjaardag", "default": "Verjaardag" },
    { "type": "text", "id": "email_label", "label": "Label e-mail (schermlezer)", "default": "Jouw e-mailadres" },
    { "type": "text", "id": "email_placeholder", "label": "Placeholder e-mail", "default": "Jouw e-mailadres" },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Houd me op de hoogte" },
    { "type": "text", "id": "tag", "label": "Klant-tag", "default": "kwispelkalender" },
    { "type": "text", "id": "success_text", "label": "Bevestigingstekst", "default": "Hoera! We houden je op de hoogte van de verjaardag van je hond." }
  ],
  "presets": [{ "name": "Verjaardagsblok" }]
}
{% endschema %}
