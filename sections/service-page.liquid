{%- comment -%}
  sections/service-page.liquid — KB-v4 herbruikbare SERVICE page-family (namespace `svc`).
  Zones (vaste volgorde, ongeacht block-volgorde): hero → quick-info cards → content-secties
  → FAQ-accordions → support-CTA → gerelateerde links. Blocktypes: quickcard, section, faq, link.
  Content komt uit block-richtext (editeerbaar); geen hardcoded claims.
{%- endcomment -%}

{%- assign quickcards = section.blocks | where: 'type', 'quickcard' -%}
{%- assign content_sections = section.blocks | where: 'type', 'section' -%}
{%- assign faqs = section.blocks | where: 'type', 'faq' -%}
{%- assign links = section.blocks | where: 'type', 'link' -%}

<div class="svc full-width">
  <div class="svc__inner">

    <header class="svc__hero">
      <div class="svc__hero-main">
        {%- if section.settings.eyebrow != blank -%}
          <span class="svc__eyebrow"><span class="svc__eyebrow-ic" aria-hidden="true">{%- render 'kb-icon', icon: section.settings.eyebrow_icon -%}</span>{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}<h1 class="svc__title">{{ section.settings.title }}</h1>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="svc__intro">{{ section.settings.intro }}</p>{%- endif -%}
      </div>
      {%- if section.settings.side_title != blank or section.settings.side_text != blank -%}
        <aside class="svc__hero-card">
          <span class="svc__hero-card-ic" aria-hidden="true">{%- render 'kb-icon', icon: section.settings.side_icon -%}</span>
          {%- if section.settings.side_title != blank -%}<strong class="svc__hero-card-title">{{ section.settings.side_title }}</strong>{%- endif -%}
          {%- if section.settings.side_text != blank -%}<span class="svc__hero-card-text">{{ section.settings.side_text }}</span>{%- endif -%}
        </aside>
      {%- endif -%}
    </header>

    {%- if quickcards.size > 0 -%}
      <ul class="svc__quick" role="list">
        {%- for b in quickcards -%}
          <li class="svc-qc svc-qc--{{ b.settings.color }}" {{ b.shopify_attributes }}>
            <span class="svc-qc__ic" aria-hidden="true">{%- render 'kb-icon', icon: b.settings.icon -%}</span>
            <span class="svc-qc__body">
              {%- if b.settings.title != blank -%}<strong class="svc-qc__title">{{ b.settings.title }}</strong>{%- endif -%}
              {%- if b.settings.text != blank -%}<span class="svc-qc__text">{{ b.settings.text }}</span>{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if content_sections.size > 0 -%}
      <article class="svc__content">
        {%- for b in content_sections -%}
          <section class="svc-sec" {{ b.shopify_attributes }}>
            {%- if b.settings.heading != blank -%}
              <h2 class="svc-sec__title">{%- if b.settings.icon != blank and b.settings.icon != 'none' -%}<span class="svc-sec__icon" aria-hidden="true">{%- render 'kb-icon', icon: b.settings.icon -%}</span>{%- endif -%}{{ b.settings.heading }}</h2>
            {%- endif -%}
            {%- if b.settings.text != blank -%}<div class="svc-sec__text">{{ b.settings.text }}</div>{%- endif -%}
          </section>
        {%- endfor -%}
      </article>
    {%- endif -%}

    {%- if faqs.size > 0 -%}
      <div class="svc__faq">
        {%- if section.settings.faq_title != blank -%}<h2 class="svc__faq-title">{{ section.settings.faq_title }}</h2>{%- endif -%}
        {%- for b in faqs -%}
          <details class="svc-acc" {{ b.shopify_attributes }}>
            <summary class="svc-acc__head"><span class="svc-acc__q">{{ b.settings.question }}</span><span class="svc-acc__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
            <div class="svc-acc__body">{{ b.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="svc__cta">
        <span class="svc__cta-ic" aria-hidden="true">{%- render 'kb-icon', icon: 'chat' -%}</span>
        <div class="svc__cta-body">
          <strong>{{ section.settings.cta_title | default: 'Nog een vraag?' }}</strong>
          <span>{{ section.settings.cta_text }}</span>
        </div>
        {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="svc__cta-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if links.size > 0 -%}
      <nav class="svc__links" aria-label="Gerelateerde pagina's">
        {%- if section.settings.links_title != blank -%}<span class="svc__links-title">{{ section.settings.links_title }}</span>{%- endif -%}
        <ul class="svc__links-list" role="list">
          {%- for b in links -%}
            <li><a href="{{ b.settings.url | default: '#' }}" class="svc__link">{%- if b.settings.icon != blank and b.settings.icon != 'none' -%}<span class="svc__link-ic" aria-hidden="true">{%- render 'kb-icon', icon: b.settings.icon -%}</span>{%- endif -%}{{ b.settings.label }}<span class="svc__link-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
.svc { background: transparent; padding: var(--section-pad) 0; }
.svc__inner { max-width: 880px; margin: 0 auto; padding: 0 var(--page-margin); }

/* Hero */
.svc__hero { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 260px); align-items: center; gap: 24px; background: linear-gradient(135deg, #fff7ea 0%, #fdeef3 44%, #eef7e4 100%); border: 1px solid rgba(61,34,9,.07); border-radius: clamp(22px, 2.8vw, 30px); padding: clamp(26px, 3.6vw, 44px); box-shadow: 0 20px 48px rgba(61,34,9,.08); margin-bottom: clamp(22px, 3vw, 36px); }
.svc__hero::after { content: ""; position: absolute; right: -60px; bottom: -80px; width: 260px; height: 260px; border-radius: 50%; background: radial-gradient(circle at 50% 50%, rgba(102,170,68,.14), transparent 70%); pointer-events: none; }
.svc__hero-main { position: relative; z-index: 1; min-width: 0; }
.svc__eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-body); font-size: var(--fs-eyebrow); font-weight: 800; text-transform: uppercase; letter-spacing: .09em; color: var(--color-green); margin-bottom: 12px; }
.svc__eyebrow-ic { display: inline-flex; color: var(--color-pink); }
.svc__eyebrow-ic svg { width: 16px; height: 16px; }
.svc__title { font-family: var(--font-heading); font-size: var(--fs-h2); line-height: 1.04; color: var(--color-ink); margin: 0 0 10px; }
.svc__intro { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 54ch; }
.svc__hero-card { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 4px; background: rgba(255,255,255,.85); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); border: 1px solid rgba(61,34,9,.06); border-radius: 18px; padding: 16px 18px; box-shadow: 0 6px 18px rgba(61,34,9,.05); min-width: 0; }
.svc__hero-card-ic { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; background: #fff0f5; color: var(--color-pink); margin-bottom: 4px; }
.svc__hero-card-ic svg { width: 22px; height: 22px; }
.svc__hero-card-title { font-family: var(--font-heading); font-size: 1rem; color: var(--color-ink); }
.svc__hero-card-text { font-family: var(--font-body); font-size: .86rem; line-height: 1.45; color: var(--color-body); }

/* Quick-info cards */
.svc__quick { list-style: none; margin: 0 0 clamp(18px, 2.4vw, 26px); padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
.svc-qc { --c: var(--color-green); --c-soft: #eef7e8; display: flex; align-items: center; gap: 11px; background: #fff; border: 1px solid rgba(61,34,9,.05); border-radius: 14px; padding: 11px 13px; box-shadow: 0 2px 8px rgba(61,34,9,.03); min-width: 0; }
.svc-qc--green  { --c: var(--color-green);  --c-soft: #eef7e8; }
.svc-qc--pink   { --c: var(--color-pink);   --c-soft: #fdeaf2; }
.svc-qc--orange { --c: var(--color-orange); --c-soft: #fdf0e2; }
.svc-qc--yellow { --c: #d99100;             --c-soft: #fdf6e0; }
.svc-qc__ic { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: var(--c-soft); color: var(--c); }
.svc-qc__ic svg { width: 19px; height: 19px; }
.svc-qc__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.svc-qc__title { font-family: var(--font-heading); font-size: .98rem; color: var(--color-ink); line-height: 1.15; }
.svc-qc__text { font-family: var(--font-body); font-size: .82rem; line-height: 1.4; color: var(--color-body); }

/* Content-secties */
.svc__content { background: #fff; border: 1px solid rgba(61,34,9,.06); border-radius: 22px; box-shadow: 0 10px 28px rgba(61,34,9,.05); padding: 2px clamp(18px, 2.6vw, 34px); }
.svc-sec { padding: clamp(18px, 2.2vw, 26px) 0; }
.svc-sec + .svc-sec { border-top: 1px solid var(--color-line); }
.svc-sec__title { display: flex; align-items: center; gap: 11px; font-family: var(--font-heading); font-size: 1.24rem; color: var(--color-ink); line-height: 1.15; margin: 0 0 10px; }
.svc-sec__icon { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background: #e8f5e2; color: var(--color-green); flex-shrink: 0; }
.svc-sec__icon svg { width: 20px; height: 20px; }
.svc-sec__text { font-family: var(--font-body); font-size: var(--fs-body); line-height: 1.7; color: var(--color-body); }
.svc-sec__text p { margin: 0 0 12px; }
.svc-sec__text :last-child { margin-bottom: 0; }
.svc-sec__text ul, .svc-sec__text ol { margin: 0 0 12px; padding-left: 22px; }
.svc-sec__text li { margin-bottom: 6px; }
.svc-sec__text a { color: var(--color-green); font-weight: 700; }
.svc-sec__text strong { color: var(--color-ink); }

/* FAQ-accordions */
.svc__faq { margin-top: clamp(20px, 3vw, 30px); background: #fff; border: 1px solid rgba(61,34,9,.07); border-radius: 20px; box-shadow: 0 8px 22px rgba(61,34,9,.04); padding: 6px clamp(16px, 2vw, 24px); }
.svc__faq-title { font-family: var(--font-heading); font-size: 1.2rem; color: var(--color-ink); margin: 16px 2px 4px; }
.svc-acc { border-bottom: 1px solid var(--color-line); }
.svc-acc:last-child { border-bottom: none; }
.svc-acc__head { list-style: none; display: flex; align-items: center; gap: 12px; padding: 16px 2px; cursor: pointer; font-family: var(--font-heading); font-size: 1.04rem; color: var(--color-ink); }
.svc-acc__head::-webkit-details-marker { display: none; }
.svc-acc__q { flex: 1; min-width: 0; }
.svc-acc__chev { display: inline-flex; color: var(--color-muted); transition: transform 200ms; }
.svc-acc__chev svg { width: 18px; height: 18px; }
.svc-acc[open] .svc-acc__chev { transform: rotate(180deg); }
.svc-acc__body { padding: 0 2px 18px; font-family: var(--font-body); font-size: .95rem; line-height: 1.65; color: var(--color-body); }
.svc-acc__body p { margin: 0 0 10px; }
.svc-acc__body :last-child { margin-bottom: 0; }
.svc-acc__body a { color: var(--color-green); font-weight: 700; }

/* Support-CTA */
.svc__cta { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: clamp(24px, 3vw, 34px); background: linear-gradient(135deg, #fff3ea 0%, #ffe4ef 100%); border: 1px solid rgba(231,84,128,.12); border-radius: 24px; padding: clamp(22px, 2.8vw, 30px) clamp(22px, 2.8vw, 30px); box-shadow: 0 12px 30px rgba(231,84,128,.08); }
.svc__cta-ic { display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; border-radius: 50%; background: #fff; color: var(--color-pink); flex-shrink: 0; box-shadow: 0 4px 12px rgba(231,84,128,.12); }
.svc__cta-ic svg { width: 24px; height: 24px; }
.svc__cta-body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 180px; }
.svc__cta-body strong { font-family: var(--font-heading); font-size: 1.1rem; color: var(--color-ink); }
.svc__cta-body span { font-family: var(--font-body); font-size: .9rem; color: var(--color-body); }
.svc__cta-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 24px; background: var(--color-green); color: #fff; border-radius: var(--radius-pill); font-family: var(--font-heading); font-size: 1rem; text-decoration: none; transition: background 160ms, transform 160ms; }
.svc__cta-btn:hover { background: #5a9a3b; transform: translateY(-2px); }

/* Gerelateerde links */
.svc__links { margin-top: clamp(18px, 2.4vw, 26px); background: #fff; border: 1px solid rgba(61,34,9,.06); border-radius: 18px; box-shadow: 0 6px 18px rgba(61,34,9,.04); padding: 2px clamp(16px, 2vw, 22px); }
.svc__links-title { display: block; font-family: var(--font-body); font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--color-muted); padding: 15px 2px 3px; }
.svc__links-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.svc__link { display: flex; align-items: center; gap: 12px; padding: 14px 2px; border-top: 1px solid var(--color-line); font-family: var(--font-body); font-size: .96rem; font-weight: 700; color: var(--color-ink); text-decoration: none; transition: color 140ms; }
.svc__link:hover { color: var(--color-green); }
.svc__link-ic { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: #eef7e8; color: var(--color-green); flex-shrink: 0; }
.svc__link-ic svg { width: 17px; height: 17px; }
.svc__link-arrow { display: inline-flex; margin-left: auto; color: var(--color-muted); transition: transform 140ms; }
.svc__link:hover .svc__link-arrow { transform: translateX(3px); color: var(--color-green); }
.svc__link-arrow svg { width: 16px; height: 16px; }

@media (max-width: 749px) {
  .svc__hero { grid-template-columns: 1fr; gap: 16px; }
  .svc__cta-btn { flex: 1 0 100%; justify-content: center; }
}
{% endstylesheet %}

