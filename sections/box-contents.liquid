{%- comment -%}
  sections/box-contents.liquid — Kwispelbox KB-v4
  "Wat zit er in de box?" — omkaderde, gelaagde split-sectie:
  links een speelse showcase-tegel (hero-foto of icon-collage) + badge + waarborgen,
  rechts rijke inhoudskaarten uit custom.whats_inside (blocks = fallback).
  Daaronder ondersteunende accordions (maat / levering / veiligheid) in een nette kaart.
  Mobiel: alles compact gestapeld.
{%- endcomment -%}

{%- assign card_blocks = section.blocks | where: 'type', 'card' -%}
{%- assign wi = product.metafields.custom.whats_inside.value -%}
{%- assign wi_colors = 'green,pink,orange,yellow' | split: ',' -%}

<div class="kbox full-width">
  <div class="kbox__inner">
    <div class="kbox__panel">

      {%- if section.settings.show_decorations -%}
        <div class="kbox__deco" aria-hidden="true">
          <span class="kbox__deco-i kbox__deco--heart"><svg viewBox="0 0 24 24" fill="none" stroke="var(--color-pink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></span>
          <span class="kbox__deco-i kbox__deco--spark"><svg viewBox="0 0 24 24" fill="var(--color-yellow)"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z"/></svg></span>
          <span class="kbox__deco-i kbox__deco--paw"><svg viewBox="0 0 24 24" fill="var(--color-orange)"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg></span>
        </div>
      {%- endif -%}

      <div class="kbox__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="kbox__eyebrow">
            <span class="kbox__eyebrow-icon" aria-hidden="true">{%- render 'kb-icon', icon: 'heart' -%}</span>
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kbox__heading">{{ section.settings.heading }}{%- if section.settings.heading_highlight != blank %} <span class="kbox__heading-em">{{ section.settings.heading_highlight }}</span>{%- endif -%}{{ section.settings.heading_suffix }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="kbox__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>

      <div class="kbox__layout">

        <aside class="kbox__showcase">
          <div class="kbox__showcase-tile{% unless section.settings.image %} kbox__showcase-tile--art{% endunless %}">
            {%- if section.settings.image != blank -%}
              <img
                src="{{ section.settings.image | image_url: width: 900 }}"
                srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 900 }} 900w"
                sizes="(max-width: 859px) 92vw, 36vw"
                alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
                width="640" height="640" loading="lazy"
                class="kbox__showcase-img">
            {%- else -%}
              <span class="kbox__art-float kbox__art-float--paw" aria-hidden="true">{%- render 'kb-icon', icon: 'paw' -%}</span>
              <span class="kbox__art-float kbox__art-float--heart" aria-hidden="true">{%- render 'kb-icon', icon: 'heart' -%}</span>
              <span class="kbox__art-float kbox__art-float--spark" aria-hidden="true">{%- render 'kb-icon', icon: 'sparkles' -%}</span>
              <span class="kbox__art-float kbox__art-float--bone" aria-hidden="true">{%- render 'kb-icon', icon: 'bone' -%}</span>
              <span class="kbox__art-gift" aria-hidden="true">{%- render 'kb-icon', icon: 'gift' -%}</span>
            {%- endif -%}

            {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
              <div class="kbox__badge">
                <svg class="kbox__badge-shape" viewBox="0 0 124 124" aria-hidden="true"><g fill="currentColor"><circle cx="110" cy="62" r="13"/><circle cx="103.6" cy="86" r="13"/><circle cx="86" cy="103.6" r="13"/><circle cx="62" cy="110" r="13"/><circle cx="38" cy="103.6" r="13"/><circle cx="20.4" cy="86" r="13"/><circle cx="14" cy="62" r="13"/><circle cx="20.4" cy="38" r="13"/><circle cx="38" cy="20.4" r="13"/><circle cx="62" cy="14" r="13"/><circle cx="86" cy="20.4" r="13"/><circle cx="103.6" cy="38" r="13"/><circle cx="62" cy="62" r="47"/></g></svg>
                <span class="kbox__badge-inner">
                  <span class="kbox__badge-heart" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></span>
                  <span class="kbox__badge-text">{{ section.settings.badge_text }}</span>
                </span>
              </div>
            {%- endif -%}
          </div>

          <ul class="kbox__assure" role="list">
            <li><span class="kbox__assure-ic" aria-hidden="true">{%- render 'kb-icon', icon: 'heart' -%}</span>Met de hand samengesteld</li>
            <li><span class="kbox__assure-ic" aria-hidden="true">{%- render 'kb-icon', icon: 'shield-check' -%}</span>Hondveilig uitgekozen</li>
          </ul>
        </aside>

        <ul class="kbox__cards" role="list">
          {%- if wi.size > 0 -%}
            {%- for item in wi -%}
              {%- assign ci = forloop.index0 | modulo: 4 -%}
              {%- assign wi_icon = 'gift' -%}{%- assign wi_text = 'Een leuke verrassing in elke box' -%}
              {%- if item contains 'peeltje' -%}{%- assign wi_icon = 'bone' -%}{%- assign wi_text = 'Om lekker mee te ravotten en te spelen' -%}
              {%- elsif item contains 'nack' -%}{%- assign wi_icon = 'leaf' -%}{%- assign wi_text = 'Smakelijke traktaties om van te smullen' -%}
              {%- elsif item contains 'nuffel' -%}{%- assign wi_icon = 'heart' -%}{%- assign wi_text = 'Zacht en aaibaar — bij de grotere maten' -%}
              {%- elsif item contains 'aartje' or item contains 'erras' -%}{%- assign wi_icon = 'sparkles' -%}{%- assign wi_text = 'Altijd iets onverwachts extra' -%}
              {%- endif -%}
              <li class="kbox-card kbox-card--{{ wi_colors[ci] }}">
                <span class="kbox-card__icon" aria-hidden="true">{%- render 'kb-icon', icon: wi_icon -%}</span>
                <div class="kbox-card__body">
                  <h3 class="kbox-card__title">{{ item }}</h3>
                  <p class="kbox-card__text">{{ wi_text }}</p>
                </div>
                <span class="kbox-card__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in card_blocks -%}
              <li class="kbox-card kbox-card--{{ block.settings.color }}" {{ block.shopify_attributes }}>
                <span class="kbox-card__icon" aria-hidden="true">{%- render 'kb-icon', icon: block.settings.icon -%}</span>
                <div class="kbox-card__body">
                  <h3 class="kbox-card__title">{{ block.settings.title }}</h3>
                  {%- if block.settings.text != blank -%}<p class="kbox-card__text">{{ block.settings.text }}</p>{%- endif -%}
                </div>
                <span class="kbox-card__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

      </div>
    </div>

    {%- comment -%}
      Ondersteunende modules: maat-hulp + levering + veiligheid — in een nette kaart die
      visueel aansluit op het paneel hierboven. Rich text DIRECT renderen.
    {%- endcomment -%}
    {%- if product.metafields.custom.dog_size_info != blank or product.metafields.custom.delivery_note != blank or product.metafields.custom.safety_note != blank -%}
      <div class="kbox-support">
        {%- if product.metafields.custom.dog_size_info != blank -%}
          <details class="kbox-acc">
            <summary class="kbox-acc__head"><span class="kbox-acc__icon kbox-acc__icon--green" aria-hidden="true">{%- render 'kb-icon', icon: 'paw' -%}</span><span class="kbox-acc__title">Welke maat past bij mijn hond?</span><span class="kbox-acc__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
            <div class="kbox-acc__body">{{ product.metafields.custom.dog_size_info }}</div>
          </details>
        {%- endif -%}
        {%- if product.metafields.custom.delivery_note != blank -%}
          <details class="kbox-acc">
            <summary class="kbox-acc__head"><span class="kbox-acc__icon kbox-acc__icon--pink" aria-hidden="true">{%- render 'kb-icon', icon: 'truck' -%}</span><span class="kbox-acc__title">Levering</span><span class="kbox-acc__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
            <div class="kbox-acc__body"><p>{{ product.metafields.custom.delivery_note }}</p></div>
          </details>
        {%- endif -%}
        {%- if product.metafields.custom.safety_note != blank -%}
          <details class="kbox-acc">
            <summary class="kbox-acc__head"><span class="kbox-acc__icon kbox-acc__icon--green" aria-hidden="true">{%- render 'kb-icon', icon: 'shield-check' -%}</span><span class="kbox-acc__title">Veiligheid</span><span class="kbox-acc__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
            <div class="kbox-acc__body">{{ product.metafields.custom.safety_note }}</div>
          </details>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
.kbox { position: relative; background: transparent; padding: var(--section-pad-sm) 0; }
.kbox__inner { position: relative; z-index: 1; max-width: var(--page-width); margin: 0 auto; padding: 0 var(--page-margin); }

/* Omkaderd paneel — zachte warme gradient, subtiele border + diepte, i.p.v. losse content op de achtergrond. */
.kbox__panel { position: relative; overflow: hidden; border-radius: clamp(24px, 3vw, 34px); background: linear-gradient(162deg, #fffdf7 0%, #f3f9ec 60%, #eef7e5 100%); border: 1px solid rgba(61,34,9,.06); box-shadow: 0 24px 60px rgba(61,34,9,.07); padding: clamp(28px, 4vw, 52px) clamp(20px, 3.4vw, 50px); }

/* Decoraties binnen het paneel (hoeken) */
.kbox__deco { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.kbox__deco-i { position: absolute; display: block; }
.kbox__deco-i svg { display: block; width: 100%; height: 100%; }
.kbox__deco--heart { top: 20px; left: 22px; width: 26px; height: 26px; opacity: .5; }
.kbox__deco--spark { top: 26px; right: 30px; width: 24px; height: 24px; opacity: .55; }
.kbox__deco--paw { bottom: 22px; right: 26px; width: 30px; height: 30px; opacity: .14; transform: rotate(14deg); }

/* Kop */
.kbox__head { position: relative; z-index: 1; text-align: center; max-width: 660px; margin: 0 auto clamp(24px, 3vw, 38px); }
.kbox__eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-body); font-size: var(--fs-eyebrow); font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--color-pink); margin-bottom: 12px; }
.kbox__eyebrow-icon { display: inline-flex; }
.kbox__eyebrow-icon svg { width: 16px; height: 16px; }
.kbox__heading { font-family: var(--font-heading); font-size: calc(var(--fs-h2) * 0.84); line-height: 1.04; color: var(--color-ink); margin: 0; }
.kbox__heading-em { color: var(--color-green); }
.kbox__intro { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.6; color: var(--color-body); margin: 14px auto 0; max-width: 560px; }

/* Split-layout: showcase links, kaarten rechts */
.kbox__layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 38%) minmax(0, 1fr); gap: clamp(20px, 2.6vw, 36px); align-items: stretch; }

/* Showcase (links) */
.kbox__showcase { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.kbox__showcase-tile { position: relative; flex: 1; min-height: 240px; border-radius: 24px; overflow: visible; display: flex; align-items: center; justify-content: center; }
.kbox__showcase-img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 24px; box-shadow: 0 20px 44px rgba(61,34,9,.14); }
/* Zonder foto: speelse icon-collage op zachte gradient */
.kbox__showcase-tile--art { background: radial-gradient(120% 120% at 30% 20%, #fff 0%, #ffe9f2 42%, #e8f5e2 100%); box-shadow: inset 0 0 0 1px rgba(61,34,9,.04); }
.kbox__art-gift { display: inline-flex; align-items: center; justify-content: center; width: clamp(92px, 12vw, 128px); height: clamp(92px, 12vw, 128px); border-radius: 50%; background: #fff; color: var(--color-green); box-shadow: 0 16px 34px rgba(61,34,9,.12); }
.kbox__art-gift svg { width: 54%; height: 54%; }
.kbox__art-float { position: absolute; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff; box-shadow: 0 8px 20px rgba(61,34,9,.1); }
.kbox__art-float svg { width: 52%; height: 52%; }
.kbox__art-float--paw   { width: 52px; height: 52px; top: 16%; left: 12%; color: var(--color-orange); }
.kbox__art-float--heart { width: 46px; height: 46px; bottom: 16%; left: 18%; color: var(--color-pink); }
.kbox__art-float--spark { width: 44px; height: 44px; top: 18%; right: 14%; color: #d99100; }
.kbox__art-float--bone  { width: 50px; height: 50px; bottom: 14%; right: 12%; color: var(--color-green); }

/* Waarborgen onder de tegel */
.kbox__assure { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.kbox__assure li { display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1px solid rgba(61,34,9,.07); border-radius: var(--radius-pill); padding: 7px 13px; font-family: var(--font-body); font-size: .82rem; font-weight: 700; color: var(--color-ink); box-shadow: 0 2px 8px rgba(61,34,9,.04); }
.kbox__assure-ic { display: inline-flex; color: var(--color-green); }
.kbox__assure-ic svg { width: 15px; height: 15px; }

/* Scalloped badge (op de tegel) */
.kbox__badge { position: absolute; top: -8px; left: -10px; width: clamp(96px, 10vw, 120px); height: clamp(96px, 10vw, 120px); color: var(--color-yellow); transform: rotate(-9deg); filter: drop-shadow(0 10px 20px rgba(61,34,9,.2)); z-index: 2; }
.kbox__badge-shape { position: absolute; inset: 0; width: 100%; height: 100%; }
.kbox__badge-inner { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 15px; text-align: center; }
.kbox__badge-heart { display: inline-flex; color: #fff; }
.kbox__badge-heart svg { width: 20px; height: 20px; }
.kbox__badge-text { font-family: var(--font-heading); font-size: .78rem; line-height: 1.12; color: var(--color-ink); max-width: 82px; }

/* Inhoudskaarten (rechts) */
.kbox__cards { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; justify-content: space-between; }
.kbox-card { --c: var(--color-green); --c-soft: #eef7e8; position: relative; display: flex; align-items: center; gap: 16px; background: #fff; border: 1px solid #f1ead9; border-radius: 20px; padding: 16px 18px; box-shadow: 0 8px 24px rgba(61,34,9,.05); transition: transform 200ms ease, box-shadow 200ms ease; }
.kbox-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-card-hover); }
.kbox-card::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 4px; border-radius: 0 4px 4px 0; background: var(--c); opacity: .9; }
.kbox-card--green  { --c: var(--color-green);  --c-soft: #eef7e8; }
.kbox-card--pink   { --c: var(--color-pink);   --c-soft: #fdeaf2; }
.kbox-card--orange { --c: var(--color-orange); --c-soft: #fdf0e2; }
.kbox-card--yellow { --c: #d99100;             --c-soft: #fdf6e0; }
.kbox-card__icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%; background: var(--c-soft); color: var(--c); }
.kbox-card__icon svg { width: 26px; height: 26px; }
.kbox-card__body { min-width: 0; flex: 1; }
.kbox-card__title { font-family: var(--font-heading); font-size: 1.12rem; color: var(--color-ink); line-height: 1.15; margin: 0 0 3px; }
.kbox-card__text { font-family: var(--font-body); font-size: .9rem; line-height: 1.5; color: var(--color-body); margin: 0; }
.kbox-card__check { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--c-soft); color: var(--c); }
.kbox-card__check svg { width: 15px; height: 15px; }

/* Tablet */
@media (max-width: 1100px) and (min-width: 860px) {
  .kbox__layout { gap: 20px; }
  .kbox-card { padding: 14px; gap: 12px; }
  .kbox-card__icon { width: 46px; height: 46px; }
}

/* Mobiel: kop → showcase → kaarten gestapeld */
@media (max-width: 859px) {
  .kbox__layout { grid-template-columns: 1fr; gap: 16px; }
  .kbox__showcase-tile { min-height: 0; aspect-ratio: 16 / 10; }
  .kbox__art-gift { width: 92px; height: 92px; }
  .kbox__assure { justify-content: center; }
  .kbox__cards { gap: 10px; }
  .kbox__badge { width: 92px; height: 92px; top: 8px; left: 8px; }
  .kbox__badge-text { font-size: .72rem; }
  .kbox-card { padding: 13px 14px; gap: 12px; }
  .kbox-card__icon { width: 46px; height: 46px; }
  .kbox-card__icon svg { width: 23px; height: 23px; }
  .kbox-card__title { font-size: 1.02rem; }
  .kbox-card__text { font-size: .85rem; line-height: 1.45; }
}
@media (max-width: 400px) {
  .kbox-card__check { display: none; }
}

/* Ondersteunende accordions — in een nette kaart die aansluit op het paneel */
.kbox-support { max-width: 820px; margin: clamp(16px, 2.2vw, 26px) auto 0; background: #fff; border: 1px solid rgba(61,34,9,.06); border-radius: 20px; box-shadow: 0 10px 30px rgba(61,34,9,.05); padding: 4px clamp(14px, 2vw, 24px); }
.kbox-acc { border-bottom: 1px solid var(--color-line); }
.kbox-acc:last-child { border-bottom: none; }
.kbox-acc__head { list-style: none; display: flex; align-items: center; gap: 12px; padding: 16px 2px; cursor: pointer; font-family: var(--font-heading); font-size: 1.05rem; color: var(--color-ink); }
.kbox-acc__head::-webkit-details-marker { display: none; }
.kbox-acc__icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: #e8f5e2; color: var(--color-green); }
.kbox-acc__icon--pink { background: #ffe0ee; color: var(--color-pink); }
.kbox-acc__icon svg { width: 18px; height: 18px; }
.kbox-acc__title { flex: 1; }
.kbox-acc__chev { display: inline-flex; color: var(--color-muted); transition: transform 200ms; }
.kbox-acc__chev svg { width: 18px; height: 18px; }
.kbox-acc[open] .kbox-acc__chev { transform: rotate(180deg); }
.kbox-acc__body { padding: 0 2px 18px 50px; font-family: var(--font-body); font-size: .95rem; line-height: 1.6; color: var(--color-body); }
.kbox-acc__body p { margin: 0 0 8px; }
.kbox-acc__body :last-child { margin-bottom: 0; }
@media (max-width: 749px) { .kbox-acc__body { padding-left: 2px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Inhoud Kwispelbox",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Elke box met liefde samengesteld" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wat zit er in een" },
    { "type": "text", "id": "heading_highlight", "label": "Kop accent (groen)", "default": "Kwispelbox" },
    { "type": "text", "id": "heading_suffix", "label": "Kop slot", "default": "?" },
    { "type": "textarea", "id": "intro", "label": "Subtekst", "default": "Geen standaard cadeautje, maar een zorgvuldig samengestelde verrassing afgestemd op jouw hond." },
    { "type": "header", "content": "Showcase-afbeelding (optioneel)" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding (blije hond + geopende box)", "info": "Leeg laten = speelse icon-collage als showcase." },
    { "type": "checkbox", "id": "show_badge", "label": "Badge tonen", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge tekst", "default": "Geen twee boxen zijn hetzelfde" },
    { "type": "header", "content": "Decoratie" },
    { "type": "checkbox", "id": "show_decorations", "label": "Decoratieve merkaccenten tonen", "default": true }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Informatiekaart",
      "limit": 8,
