{%- comment -%}
  sections/usp-bar.liquid — Kwispelbox KB-v4
  Lichte USP-balk met 4 items (icoon + 2 regels), volgens docs/mockup-home.png
{%- endcomment -%}

{%- assign usp_blocks = section.blocks | where: 'type', 'usp' -%}

{%- if usp_blocks.size > 0 -%}
<section class="uspb full-width">
  <div class="uspb__inner">
    {%- for block in usp_blocks -%}
      <div class="uspb__item" {{ block.shopify_attributes }}>
        <span class="uspb__icon uspb__icon--{{ block.settings.color }}" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>
        <span class="uspb__text">
          <strong>{{ block.settings.title }}</strong>
          {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.uspb { background: transparent; }
.uspb__inner { max-width: var(--page-width); margin: 0 auto; padding: 18px var(--page-margin); display: flex; align-items: stretch; gap: 0; background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
/* de balk zelf smaller dan de rand-inner: */
.uspb { padding: 0 var(--page-margin); }
.uspb__inner { padding: 20px 28px; }
.uspb__item { flex: 1; display: flex; align-items: center; gap: 12px; padding: 0 22px; border-right: 1px solid var(--color-line); }
.uspb__item:first-child { padding-left: 0; }
.uspb__item:last-child { border-right: none; padding-right: 0; }
.uspb__icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.uspb__icon svg { width: 26px; height: 26px; stroke-width: 1.8; }
.uspb__icon--green  { color: var(--color-green); }
.uspb__icon--orange { color: var(--color-orange); }
.uspb__icon--pink   { color: #e75480; }
.uspb__icon--yellow { color: #d99a00; }
.uspb__icon--ink    { color: var(--color-ink); }
.uspb__text { display: flex; flex-direction: column; line-height: 1.25; }
.uspb__text strong { font-family: var(--font-body); font-size: .92rem; font-weight: 800; color: var(--color-ink); }
.uspb__text span { font-family: var(--font-body); font-size: .85rem; color: var(--color-muted); }

@media (max-width: 749px) {
  .uspb__inner { flex-wrap: wrap; padding: 18px; gap: 16px 0; }
  .uspb__item { flex: 0 0 50%; border-right: none; padding: 0 10px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "USP balk",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Titel (regel 1)", "default": "Gratis verzending" },
        { "type": "text", "id": "subtitle", "label": "Subtitel (regel 2)", "default": "vanaf €50" },
        { "type": "select", "id": "icon", "label": "Icoon", "default": "truck", "options": [
          { "value": "truck", "label": "Vrachtwagen" },
          { "value": "clock", "label": "Klok" },
          { "value": "heart", "label": "Hart" },
          { "value": "leaf", "label": "Blad" },
          { "value": "gift", "label": "Cadeau" },
          { "value": "shield-check", "label": "Schild" },
          { "value": "paw", "label": "Poot" },
          { "value": "star", "label": "Ster" }
        ]},
        { "type": "select", "id": "color", "label": "Icoonkleur", "default": "green", "options": [
          { "value": "green", "label": "Groen" },
          { "value": "orange", "label": "Oranje" },
          { "value": "pink", "label": "Roze" },
          { "value": "yellow", "label": "Geel" },
          { "value": "ink", "label": "Bruin" }
        ]}
      ]
    }
  ],
  "presets": [
    {
      "name": "USP balk",
      "blocks": [
        { "type": "usp", "settings": { "title": "Gratis verzending", "subtitle": "vanaf €50", "icon": "truck", "color": "ink" } },
        { "type": "usp", "settings": { "title": "Voor 16:00 besteld", "subtitle": "morgen in huis", "icon": "clock", "color": "ink" } },
        { "type": "usp", "settings": { "title": "Met een persoonlijk", "subtitle": "kaartje", "icon": "heart", "color": "pink" } },
        { "type": "usp", "settings": { "title": "Duurzame en", "subtitle": "hondvriendelijke producten", "icon": "leaf", "color": "green" } }
      ]
    }
  ]
}
{% endschema %}
