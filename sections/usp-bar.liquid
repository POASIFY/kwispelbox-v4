{%- comment -%}
  sections/usp-bar.liquid — Kwispelbox KB-v4
  Lichte USP-balk met 4 items (icoon + 2 regels), volgens docs/mockup-home.png
{%- endcomment -%}

{%- assign usp_blocks = section.blocks | where: 'type', 'usp' -%}

{%- if usp_blocks.size > 0 -%}
<section class="uspb full-width">
  <div class="uspb__inner">
    {%- for block in usp_blocks -%}
      <div class="uspb__item" {{ block.shopify_attributes }}>
        <span class="uspb__icon uspb__icon--{{ block.settings.color }}" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>
        <span class="uspb__text">
          <strong>{{ block.settings.title }}</strong>
          {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.uspb { background: transparent; padding: 0 var(--page-margin); }
.uspb__inner { max-width: var(--page-width); margin: 0 auto; padding: 6px 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.uspb__item { display: flex; align-items: center; gap: 13px; min-width: 0; padding: 15px 18px; background: #fffaf2; border-radius: var(--radius-lg); box-shadow: 0 5px 16px rgba(61,34,9,.05); }
.uspb__icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 46px; height: 46px; border-radius: 50%; }
.uspb__icon svg { width: 23px; height: 23px; stroke-width: 1.9; }
.uspb__icon--green  { background: #e3f1d9; color: var(--color-green); }
.uspb__icon--orange { background: #fdf0e2; color: var(--color-orange); }
.uspb__icon--pink   { background: #fdeaf2; color: #e75480; }
.uspb__icon--yellow { background: #fbf0d0; color: #d99a00; }
.uspb__icon--ink    { background: #f0e8dd; color: var(--color-ink); }
.uspb__text { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
.uspb__text strong { font-family: var(--font-body); font-size: .9rem; font-weight: 700; letter-spacing: .005em; color: var(--color-ink); }
.uspb__text span { font-family: var(--font-body); font-size: .82rem; color: var(--color-muted); }

@media (max-width: 989px) { .uspb__inner { grid-template-columns: 1fr 1fr; } }
@media (max-width: 480px) {
  .uspb__inner { grid-template-columns: 1fr 1fr; gap: 10px; }
  .uspb__item { flex-direction: column; text-align: center; gap: 8px; padding: 16px 10px; }
  .uspb__text { align-items: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "USP balk",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Titel (regel 1)", "default": "Gratis verzending" },
        { "type": "text", "id": "subtitle", "label": "Subtitel (regel 2)", "default": "vanaf €50" },
        { "type": "select", "id": "icon", "label": "Icoon", "default": "truck", "options": [
          { "value": "truck", "label": "Vrachtwagen" },
          { "value": "clock", "label": "Klok" },
          { "value": "heart", "label": "Hart" },
          { "value": "leaf", "label": "Blad" },
          { "value": "gift", "label": "Cadeau" },
          { "value": "shield-check", "label": "Schild" },
          { "value": "paw", "label": "Poot" },
          { "value": "star", "label": "Ster" }
        ]},
        { "type": "select", "id": "color", "label": "Icoonkleur", "default": "green", "options": [
          { "value": "green", "label": "Groen" },
          { "value": "orange", "label": "Oranje" },
          { "value": "pink", "label": "Roze" },
          { "value": "yellow", "label": "Geel" },
          { "value": "ink", "label": "Bruin" }
        ]}
      ]
    }
  ],
  "presets": [
    {
      "name": "USP balk",
      "blocks": [
        { "type": "usp", "settings": { "title": "Gratis verzending", "subtitle": "vanaf €50", "icon": "truck", "color": "green" } },
        { "type": "usp", "settings": { "title": "Voor 16:00 besteld", "subtitle": "morgen in huis", "icon": "clock", "color": "orange" } },
        { "type": "usp", "settings": { "title": "Met een persoonlijk", "subtitle": "kaartje", "icon": "heart", "color": "pink" } },
        { "type": "usp", "settings": { "title": "Duurzame en", "subtitle": "hondvriendelijke producten", "icon": "leaf", "color": "yellow" } }
      ]
    }
  ]
}
{% endschema %}
