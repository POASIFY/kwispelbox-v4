{%- comment -%}
  sections/happy-dogs.liquid — Kwispelbox KB-v4
  "Blije honden, blije baasjes" — fotoslider met afbeeldingsblocks. Volgens docs/mockup-home.png.
{%- endcomment -%}

{%- assign photos = section.blocks | where: 'type', 'photo' -%}
{%- assign pal = 'pink,green,orange,yellow' | split: ',' -%}

<section class="hd full-width" data-hd>
  <div class="hd__inner">
    <div class="hd__head">
      <div class="hd__head-text">
        {%- if section.settings.heading != blank -%}
          <h2 class="hd__heading">
            {{ section.settings.heading }}
            <span class="hd__heading-heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hd__sub">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- assign ig_url = section.settings.button_url | default: settings.social_instagram -%}
      {%- if section.settings.button_label != blank and ig_url != blank and ig_url != '#' -%}
        <a href="{{ ig_url }}" class="hd__ig" target="_blank" rel="noopener">
          <span class="hd__ig-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></span>
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if photos.size > 0 -%}
    <div class="hd__slider">
      <button type="button" class="hd__nav hd__nav--prev" aria-label="Vorige" data-hd-prev>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <ul class="hd__track" role="list" data-hd-track>
        {%- for block in photos -%}
          {%- assign ti = forloop.index0 | modulo: 4 -%}
          {%- assign tint = pal[ti] -%}
          <li class="hd__slide" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,350,500', sizes: '(max-width: 749px) 72vw, (max-width: 989px) 30vw, 235px', alt: block.settings.image.alt | default: block.settings.dog_name | default: 'Blije hond', class: 'hd__img' }}
            {%- else -%}
              <span class="hd__img hd__img--ph hd__img--{{ tint }}">{%- render 'lucide', icon: 'dog' -%}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="hd__nav hd__nav--next" aria-label="Volgende" data-hd-next>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.hd { background: transparent; }
.hd__inner { max-width: var(--page-width); margin: 0 auto; padding: var(--section-pad-sm) var(--page-margin) 16px; }
.hd__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
.hd__head-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.hd__heading { font-family: var(--font-heading); font-size: calc(var(--fs-h2) * 0.93); color: var(--color-ink); margin: 0; display: flex; align-items: center; gap: 10px; }
.hd__heading-heart { display: inline-flex; color: var(--color-pink); }
.hd__heading-heart svg { width: .7em; height: .7em; fill: none; stroke: currentColor; stroke-width: 2.4; }
.hd__sub { font-family: var(--font-body); font-size: 1rem; color: var(--color-muted); margin: 0; }
.hd__ig { display: inline-flex; align-items: center; gap: 9px; flex-shrink: 0; background: var(--color-pink); color: #fff; font-family: var(--font-heading); font-size: 1rem; letter-spacing: var(--ls-button); padding: 11px 20px; border-radius: var(--radius-pill); text-decoration: none; box-shadow: 0 10px 24px rgba(231,84,128,.26); transition: transform 160ms, filter 160ms; white-space: nowrap; }
.hd__ig:hover { transform: translateY(-2px); filter: brightness(1.04); }
.hd__ig-icon { display: inline-flex; }
.hd__ig-icon svg { width: 18px; height: 18px; }

.hd__slider { position: relative; max-width: var(--page-width); margin: 0 auto; padding: 8px var(--page-margin) var(--section-pad-sm); }
.hd__track { list-style: none; margin: 0; padding: 14px 4px 24px; display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.hd__track::-webkit-scrollbar { display: none; }
/* Polaroid/snapshot-kaartje: wit frame, zachte schaduw, speels scheef — klantfoto's krijgen extra liefde. */
.hd__slide { flex: 0 0 clamp(190px, 15.8%, 235px); min-width: 0; scroll-snap-align: start; background: #fff; padding: 7px 7px 14px; border-radius: 10px; box-shadow: 0 8px 20px rgba(61,34,9,.10); transition: transform 180ms, box-shadow 180ms; }
.hd__slide:nth-child(odd)  { transform: rotate(-1.6deg); }
.hd__slide:nth-child(even) { transform: rotate(1.5deg); }
.hd__slide:hover { transform: rotate(0deg) translateY(-3px); box-shadow: 0 12px 26px rgba(61,34,9,.14); }
.hd__img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 5px; }
.hd__img--ph { display: flex; align-items: center; justify-content: center; }
.hd__img--ph svg { width: 40%; height: 40%; color: rgba(255,255,255,.85); }
.hd__img--pink   { background: #f7a8c4; }
.hd__img--green  { background: #a7d18a; }
.hd__img--orange { background: #f4b06a; }
.hd__img--yellow { background: #f2cf6a; }

.hd__nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--color-line); background: #fff; color: var(--color-ink); cursor: pointer; box-shadow: var(--shadow-card); transition: background 140ms, transform 140ms; }
.hd__nav:hover { background: var(--color-cream); }
.hd__nav--prev { left: 6px; }
.hd__nav--next { right: 6px; }
.hd__nav svg { width: 20px; height: 20px; }

@media (max-width: 989px) { .hd__slide { flex-basis: 30%; } }
@media (max-width: 749px) {
  .hd__slide { flex-basis: 72%; }
  .hd__nav { display: none; }
  .hd__head { flex-direction: column; align-items: flex-start; }
  .hd__ig { width: 100%; justify-content: center; }
}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('[data-hd]').forEach(function (root) {
  var track = root.querySelector('[data-hd-track]');
  if (!track) return;
  var step = function () {
    var slide = track.querySelector('.hd__slide');
    return slide ? slide.getBoundingClientRect().width + 16 : 300;
  };
  var prev = root.querySelector('[data-hd-prev]');
  var next = root.querySelector('[data-hd-next]');
  if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step() * 2, behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function () { track.scrollBy({ left: step() * 2, behavior: 'smooth' }); });
});
{% endjavascript %}

{% schema %}
{
  "name": "Blije honden",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Blije honden, blije baasjes" },
    { "type": "text", "id": "text", "label": "Subtekst", "default": "Tag @kwispelbox en wie weet staat jouw hond hier binnenkort!" },
    { "type": "text", "id": "button_label", "label": "Knop (bijv. Volg ons op Instagram)", "default": "Volg ons op Instagram" },
    { "type": "url", "id": "button_url", "label": "Knop link", "info": "Laat leeg om de Instagram-link uit de themasettings te gebruiken. De knop verschijnt alleen als er een echte link is ingesteld." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "limit": 16,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "dog_name", "label": "Naam hond (alt-tekst)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blije honden",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
