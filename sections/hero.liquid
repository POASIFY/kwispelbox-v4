{%- comment -%}
  sections/hero.liquid — Kwispelbox KB-v4
  Homepage-hero volgens docs/mockup-home.png:
  - Speelse titel in 3 regels, per regel 2 kleursegmenten instelbaar
  - Subtekst + primaire knop (pootje + pijl)
  - Grote afbeelding (hond + box) met roze ronde sticker + speelse decoraties
  - 3 USP-kaartjes als blocks
{%- endcomment -%}

{%- comment -%} theme-check-disable AssetPreload {%- endcomment -%}
{%- if section.settings.image_priority and section.settings.image != blank or section.settings.image_priority and section.settings.image_mobile != blank -%}
  {%- assign hero_pre_desktop = section.settings.image | default: section.settings.image_mobile -%}
  {%- assign hero_pre_mobile = section.settings.image_mobile | default: section.settings.image -%}
  {%- if section.settings.image_mobile != blank -%}
    <link rel="preload" as="image" fetchpriority="high" media="(max-width: 989px)"
      href="{{ hero_pre_mobile | image_url: width: 900 }}"
      imagesrcset="{{ hero_pre_mobile | image_url: width: 600 }} 600w, {{ hero_pre_mobile | image_url: width: 900 }} 900w"
      imagesizes="100vw">
    <link rel="preload" as="image" fetchpriority="high" media="(min-width: 990px)"
      href="{{ hero_pre_desktop | image_url: width: 1200 }}"
      imagesrcset="{{ hero_pre_desktop | image_url: width: 800 }} 800w, {{ hero_pre_desktop | image_url: width: 1200 }} 1200w, {{ hero_pre_desktop | image_url: width: 1600 }} 1600w"
      imagesizes="54vw">
  {%- else -%}
    <link rel="preload" as="image" fetchpriority="high"
      href="{{ hero_pre_desktop | image_url: width: 1200 }}"
      imagesrcset="{{ hero_pre_desktop | image_url: width: 800 }} 800w, {{ hero_pre_desktop | image_url: width: 1200 }} 1200w, {{ hero_pre_desktop | image_url: width: 1600 }} 1600w"
      imagesizes="(max-width: 989px) 100vw, 54vw">
  {%- endif -%}
{%- endif -%}
{%- comment -%} theme-check-enable AssetPreload {%- endcomment -%}

{%- assign usp_blocks = section.blocks | where: 'type', 'usp' -%}

<section class="hero full-width">
  <div class="hero__inner">

    <div class="hero__intro">
      {%- if section.settings.badge_text != blank -%}
        <span class="hero__badge">
          <span class="hero__badge-icon" aria-hidden="true">{%- render 'lucide', icon: 'star' -%}</span>
          {{ section.settings.badge_text }}
        </span>
      {%- endif -%}

      <h1 class="hero__title">
        {%- for i in (1..3) -%}
          {%- assign a_key = 'line' | append: i | append: '_a' -%}
          {%- assign a_color_key = 'line' | append: i | append: '_a_color' -%}
          {%- assign b_key = 'line' | append: i | append: '_b' -%}
          {%- assign b_color_key = 'line' | append: i | append: '_b_color' -%}
          {%- assign a_text = section.settings[a_key] -%}
          {%- assign b_text = section.settings[b_key] -%}
          {%- if a_text != blank or b_text != blank -%}
            <span class="hero__ln">
              {%- if a_text != blank -%}<span class="hero__seg hero__seg--{{ section.settings[a_color_key] }}">{{ a_text }}</span>{%- endif -%}
              {%- if b_text != blank -%} <span class="hero__seg hero__seg--{{ section.settings[b_color_key] }}">{{ b_text }}</span>{%- endif -%}
              {%- if i == 3 -%}<span class="hero__title-heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>{%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.cta_primary_label != blank -%}
        <a href="{{ section.settings.cta_primary_url }}" class="hero__btn hero__btn--primary">
          <span class="hero__btn-paw" aria-hidden="true">{%- render 'lucide', icon: 'paw' -%}</span>
          {{ section.settings.cta_primary_label }}
          <span class="hero__btn-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
        </a>
      {%- endif -%}

      {%- if usp_blocks.size > 0 -%}
        <ul class="hero__usps" role="list">
          {%- for block in usp_blocks -%}
            <li class="hero__usp" {{ block.shopify_attributes }}>
              <span class="hero__usp-ic hero__usp-ic--{{ block.settings.color }}" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>
              <span class="hero__usp-text">{{ block.settings.title }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <span class="hero__deco hero__deco--t-heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      <span class="hero__deco hero__deco--t-spark" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>
      <span class="hero__deco hero__deco--t-squiggle" aria-hidden="true"><svg viewBox="0 0 40 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M2 12c4-8 8 4 12-2s8 6 12 0 8 4 12-2"/></svg></span>
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}
        {%- assign hero_desktop = section.settings.image | default: section.settings.image_mobile -%}
        {%- assign hero_mobile = section.settings.image_mobile | default: section.settings.image -%}
        <picture class="hero__pic">
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 989px)"
              srcset="{{ hero_mobile | image_url: width: 600 }} 600w, {{ hero_mobile | image_url: width: 900 }} 900w"
              sizes="100vw">
          {%- endif -%}
          <img
            src="{{ hero_desktop | image_url: width: 1200 }}"
            srcset="{{ hero_desktop | image_url: width: 800 }} 800w, {{ hero_desktop | image_url: width: 1200 }} 1200w, {{ hero_desktop | image_url: width: 1600 }} 1600w"
            sizes="(max-width: 989px) 100vw, 54vw"
            alt="{{ hero_desktop.alt | default: shop.name | escape }}"
            width="1644" height="957" decoding="async"
            {%- if section.settings.image_priority -%} loading="eager" fetchpriority="high"{%- else -%} loading="lazy"{%- endif -%}
            class="hero__img">
        </picture>
      {%- else -%}
        <span class="hero__img hero__img--ph">{%- render 'lucide', icon: 'dog' -%}</span>
      {%- endif -%}

      {%- if section.settings.circle_text != blank -%}
        <span class="hero__circle" aria-hidden="true">
          <span class="hero__circle-text">{{ section.settings.circle_text }}</span>
          <span class="hero__circle-arrow"><svg viewBox="0 0 30 36" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4c-8 6-12 16-9 27"/><path d="M4 24l7 8 8-5"/></svg></span>
        </span>
      {%- endif -%}

      <span class="hero__deco hero__deco--h1" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      <span class="hero__deco hero__deco--h2" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      <span class="hero__deco hero__deco--paws" aria-hidden="true">{%- render 'lucide', icon: 'paw' -%}{%- render 'lucide', icon: 'paw' -%}</span>
      <span class="hero__deco hero__deco--spark" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>
      <span class="hero__deco hero__deco--squiggle" aria-hidden="true"><svg viewBox="0 0 40 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M2 12c4-8 8 4 12-2s8 6 12 0 8 4 12-2"/></svg></span>
    </div>

  </div>
</section>

{% stylesheet %}
.hero { position: relative; background: transparent; overflow: hidden; }
.hero__media::before { content: ""; position: absolute; left: 50%; bottom: 2%; transform: translateX(-50%); width: 128%; height: 66%; background: radial-gradient(56% 56% at 50% 66%, #e8f5e2 0%, rgba(232,245,226,0) 72%); z-index: 0; pointer-events: none; }

.hero__inner { position: relative; z-index: 1; max-width: var(--page-width); margin: 0 auto; padding: var(--section-pad-sm) var(--page-margin) clamp(2px, 1.2vw, 10px); display: grid; grid-template-columns: 43fr 57fr; grid-template-areas: "intro media"; align-items: center; column-gap: 16px; }
.hero__intro { grid-area: intro; min-width: 0; position: relative; }
.hero__media { grid-area: media; position: relative; min-width: 0; align-self: end; }

.hero__badge { display: inline-flex; align-items: center; gap: 9px; background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-pill); padding: 8px 16px; font-family: var(--font-body); font-size: .92rem; font-weight: 700; color: var(--color-ink); box-shadow: 0 6px 18px rgba(61,34,9,.05); margin-bottom: 18px; }
.hero__badge-icon { display: inline-flex; color: var(--color-orange); }
.hero__badge-icon svg { width: 18px; height: 18px; }

.hero__title { font-family: var(--font-heading); font-size: clamp(2.7rem, 5.4vw, 4.8rem); line-height: .98; margin: 0 0 18px; letter-spacing: 0; }
.hero__ln { display: block; }
.hero__seg + .hero__seg { margin-left: .28em; }
.hero__seg--ink    { color: var(--color-ink); }
.hero__seg--green  { color: var(--color-green); }
.hero__seg--pink   { color: var(--color-pink); }
.hero__seg--orange { color: var(--color-orange); }
.hero__seg--yellow { color: var(--color-yellow); }
.hero__title-heart { display: inline-flex; color: var(--color-pink); vertical-align: middle; margin-left: .16em; }
.hero__title-heart svg { width: .58em; height: .58em; fill: none; stroke: currentColor; stroke-width: 2.4; }

.hero__text { font-family: var(--font-body); font-size: clamp(1rem, 1.3vw, 1.15rem); color: var(--color-body); line-height: 1.5; margin: 0 0 20px; max-width: 40ch; }

.hero__btn { display: inline-flex; align-items: center; gap: 10px; padding: 16px 30px; border-radius: var(--radius-pill); font-family: var(--font-heading); font-size: 1.2rem; text-decoration: none; transition: transform 160ms, box-shadow 160ms, background 160ms; }
.hero__btn--primary { background: var(--color-green); color: #fff; box-shadow: 0 12px 28px rgba(102,170,68,.32); }
.hero__btn--primary:hover { background: #5a9a3b; transform: translateY(-2px); }
.hero__btn-paw { display: inline-flex; }
.hero__btn-paw svg { width: 20px; height: 20px; }
.hero__btn-arrow { display: inline-flex; }
.hero__btn-arrow svg { width: 18px; height: 18px; }

.hero__usps { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 500px; }
.hero__usp { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--color-line); border-radius: 13px; padding: 8px 11px; box-shadow: 0 2px 8px rgba(61,34,9,.05); }
.hero__usp-ic { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; }
.hero__usp-ic svg { width: 16px; height: 16px; }
.hero__usp-ic--green  { background: #e8f5e2; color: var(--color-green); }
.hero__usp-ic--orange { background: #fff0e4; color: var(--color-orange); }
.hero__usp-ic--pink   { background: #ffe0ee; color: #e75480; }
.hero__usp-ic--yellow { background: #fffae0; color: #b07d00; }
.hero__usp-text { font-family: var(--font-body); font-size: .78rem; font-weight: 700; color: var(--color-ink); line-height: 1.2; }

.hero__pic { display: block; position: relative; z-index: 1; }
.hero__img { width: 100%; height: auto; display: block; position: relative; z-index: 1; }
.hero__img--ph { aspect-ratio: 1.7; width: 90%; margin: 0 auto; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--color-green); box-shadow: var(--shadow-card); }
.hero__img--ph svg { width: 40%; height: 40%; }

.hero__circle { position: absolute; top: 2%; right: 1%; z-index: 2; width: 100px; height: 100px; border-radius: 50%; background: var(--color-pink); display: flex; align-items: center; justify-content: center; padding: 12px; box-shadow: 0 10px 24px rgba(212,83,126,.26); text-align: center; }
.hero__circle-text { font-family: var(--font-heading); font-size: .74rem; line-height: 1.12; color: #fff; }
.hero__circle-arrow { position: absolute; bottom: -14px; left: -6px; width: 26px; height: 32px; color: var(--color-pink); }
.hero__circle-arrow svg { width: 100%; height: 100%; }

.hero__deco { position: absolute; pointer-events: none; z-index: 2; }
.hero__deco svg { display: block; width: 100%; height: 100%; }
/* intro-decoraties */
.hero__deco--t-heart { top: -2%; left: 34%; width: 26px; color: var(--color-pink); }
.hero__deco--t-heart svg { fill: none; stroke: currentColor; stroke-width: 2.2; }
.hero__deco--t-spark { top: 6%; right: 2%; width: 26px; color: var(--color-yellow); }
.hero__deco--t-squiggle { bottom: 30%; left: -2%; width: 40px; height: 16px; color: var(--color-orange); opacity: .8; }
/* media-decoraties */
.hero__deco--h1 { top: 4%; left: 6%; width: 26px; color: var(--color-pink); }
.hero__deco--h2 { bottom: 20%; right: 2%; width: 22px; color: var(--color-pink); }
.hero__deco--h1 svg, .hero__deco--h2 svg { fill: none; stroke: currentColor; stroke-width: 2.2; }
/* Selectiever: minder doodles, alleen de leukste rond kop + box */
.hero__deco--h2, .hero__deco--t-squiggle { display: none; }
.hero__deco--paws { top: 3%; right: 26%; width: 56px; height: 28px; color: var(--color-orange); opacity: .5; display: flex; gap: 6px; }
.hero__deco--spark { top: 30%; left: 0; width: 28px; color: var(--color-green); }
.hero__deco--squiggle { bottom: 8%; left: 6%; width: 40px; height: 16px; color: var(--color-green); }

@media (min-width: 990px) {
  .hero__inner { grid-template-columns: 43fr 57fr; column-gap: 12px; }
  /* Beeld groter, omhoog en optisch iets naar rechts zodat het de crème-ruimte rechtsboven vult (mockup). */
  .hero__img { transform: translate(22px, -70px) scale(1.12); transform-origin: bottom right; }
}

@media (max-width: 989px) {
  .hero__inner { grid-template-columns: 1fr; grid-template-areas: "media" "intro"; column-gap: 0; padding: var(--section-pad-sm) var(--page-margin) 24px; }
  .hero__intro { order: 2; z-index: 3; }
  .hero__media { order: 1; margin-bottom: 8px; }
  .hero__title { font-size: clamp(2.2rem, 9.5vw, 3.1rem); }
  .hero__text { max-width: 40ch; }
  .hero__btn--primary { display: flex; width: 100%; justify-content: center; }
  .hero__usps { grid-template-columns: 1fr; gap: 10px; margin-top: 22px; max-width: none; }
  .hero__circle { top: 1%; right: 1%; width: 96px; height: 96px; padding: 10px; }
  .hero__circle-text { font-size: .72rem; }
  .hero__deco--paws, .hero__deco--t-squiggle { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge boven titel (optioneel)" },
    { "type": "header", "content": "Titel — 3 regels, 2 kleursegmenten per regel", "info": "Segment B is optioneel; laat leeg voor één kleur per regel." },
    { "type": "text", "id": "line1_a", "label": "Regel 1 — deel A", "default": "Een feestje" },
    { "type": "select", "id": "line1_a_color", "label": "Kleur 1A", "default": "ink", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "text", "id": "line1_b", "label": "Regel 1 — deel B" },
    { "type": "select", "id": "line1_b_color", "label": "Kleur 1B", "default": "green", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "text", "id": "line2_a", "label": "Regel 2 — deel A", "default": "in een" },
    { "type": "select", "id": "line2_a_color", "label": "Kleur 2A", "default": "pink", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "text", "id": "line2_b", "label": "Regel 2 — deel B", "default": "doos" },
    { "type": "select", "id": "line2_b_color", "label": "Kleur 2B", "default": "orange", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "text", "id": "line3_a", "label": "Regel 3 — deel A", "default": "voor jouw hond" },
    { "type": "select", "id": "line3_a_color", "label": "Kleur 3A", "default": "green", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "text", "id": "line3_b", "label": "Regel 3 — deel B" },
    { "type": "select", "id": "line3_b_color", "label": "Kleur 3B", "default": "orange", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "header", "content": "Tekst & knop" },
    { "type": "textarea", "id": "text", "label": "Subtekst", "default": "Cadeauboxen vol speeltjes en snacks voor elke verjaardag, feestdag en elk moment." },
    { "type": "text", "id": "cta_primary_label", "label": "Knoptekst", "default": "Kies een box" },
    { "type": "url", "id": "cta_primary_url", "label": "Knop link" },
    { "type": "header", "content": "Afbeelding" },
    { "type": "image_picker", "id": "image", "label": "Hero afbeelding — desktop (hond + box)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero afbeelding — mobiel (optioneel)", "info": "Laat leeg om dezelfde afbeelding als desktop te gebruiken." },
    { "type": "text", "id": "circle_text", "label": "Roze sticker tekst", "default": "Elke box voelt als een cadeautje" },
    { "type": "checkbox", "id": "image_priority", "label": "Hoge prioriteit laden", "default": true }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP-kaartje",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Met liefde samengesteld" },
        { "type": "select", "id": "icon", "label": "Icoon", "default": "package", "options": [
          { "value": "package", "label": "Pakket" }, { "value": "gift", "label": "Cadeau" }, { "value": "leaf", "label": "Blad" }, { "value": "heart", "label": "Hart" }, { "value": "paw", "label": "Poot" }, { "value": "star", "label": "Ster" }, { "value": "shield-check", "label": "Schild" }, { "value": "sparkles", "label": "Sterretjes" }
        ]},
        { "type": "select", "id": "color", "label": "Icoon kleur", "default": "green", "options": [
          { "value": "green", "label": "Groen" }, { "value": "orange", "label": "Oranje" }, { "value": "pink", "label": "Roze" }, { "value": "yellow", "label": "Geel" }
        ]}
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "usp", "settings": { "title": "Met liefde samengesteld", "icon": "package", "color": "orange" } },
        { "type": "usp", "settings": { "title": "Alleen de beste kwaliteit", "icon": "leaf", "color": "green" } },
        { "type": "usp", "settings": { "title": "Voor blije honden en trotse baasjes", "icon": "heart", "color": "pink" } }
      ]
    }
  ]
}
{% endschema %}
