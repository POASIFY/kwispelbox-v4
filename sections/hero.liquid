{%- comment -%}
  sections/hero.liquid — Kwispelbox KB-v4
  Homepage-hero volgens docs/mockup-home.png:
  - Titel in 3 regels, kleur per regel instelbaar
  - Subtekst + primaire knop
  - Grote afbeelding (hond + box) met roze ronde sticker + decoraties
  - 3 USP-kaartjes als blocks
  Desktop: 2-koloms (tekst links, beeld rechts), USP's onder de tekst. Mobiel: gelaagd.
{%- endcomment -%}

{%- comment -%} theme-check-disable AssetPreload {%- endcomment -%}
{%- if section.settings.image_priority and section.settings.image != blank or section.settings.image_priority and section.settings.image_mobile != blank -%}
  {%- assign hero_pre_desktop = section.settings.image | default: section.settings.image_mobile -%}
  {%- assign hero_pre_mobile = section.settings.image_mobile | default: section.settings.image -%}
  {%- if section.settings.image_mobile != blank -%}
    <link rel="preload" as="image" fetchpriority="high" media="(max-width: 989px)"
      href="{{ hero_pre_mobile | image_url: width: 900 }}"
      imagesrcset="{{ hero_pre_mobile | image_url: width: 600 }} 600w, {{ hero_pre_mobile | image_url: width: 900 }} 900w"
      imagesizes="100vw">
    <link rel="preload" as="image" fetchpriority="high" media="(min-width: 990px)"
      href="{{ hero_pre_desktop | image_url: width: 1100 }}"
      imagesrcset="{{ hero_pre_desktop | image_url: width: 700 }} 700w, {{ hero_pre_desktop | image_url: width: 1100 }} 1100w, {{ hero_pre_desktop | image_url: width: 1500 }} 1500w"
      imagesizes="52vw">
  {%- else -%}
    <link rel="preload" as="image" fetchpriority="high"
      href="{{ hero_pre_desktop | image_url: width: 1100 }}"
      imagesrcset="{{ hero_pre_desktop | image_url: width: 700 }} 700w, {{ hero_pre_desktop | image_url: width: 1100 }} 1100w, {{ hero_pre_desktop | image_url: width: 1500 }} 1500w"
      imagesizes="(max-width: 989px) 100vw, 52vw">
  {%- endif -%}
{%- endif -%}
{%- comment -%} theme-check-enable AssetPreload {%- endcomment -%}

{%- assign usp_blocks = section.blocks | where: 'type', 'usp' -%}

<section class="hero full-width">
  <div class="hero__inner">

    <div class="hero__intro">
      {%- if section.settings.badge_text != blank -%}
        <span class="hero__badge">
          <span class="hero__badge-icon" aria-hidden="true">{%- render 'lucide', icon: 'star' -%}</span>
          {{ section.settings.badge_text }}
        </span>
      {%- endif -%}

      <h1 class="hero__title">
        {%- if section.settings.line1 != blank -%}<span class="hero__ln hero__ln--{{ section.settings.line1_color }}">{{ section.settings.line1 }}</span>{%- endif -%}
        {%- if section.settings.line2 != blank -%}<span class="hero__ln hero__ln--{{ section.settings.line2_color }}">{{ section.settings.line2 }}</span>{%- endif -%}
        {%- if section.settings.line3 != blank -%}<span class="hero__ln hero__ln--{{ section.settings.line3_color }}">{{ section.settings.line3 }}<span class="hero__title-heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span></span>{%- endif -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.cta_primary_label != blank -%}
        <a href="{{ section.settings.cta_primary_url }}" class="hero__btn hero__btn--primary">
          {{ section.settings.cta_primary_label }}
          <span class="hero__btn-icon" aria-hidden="true">{%- render 'lucide', icon: 'paw' -%}</span>
        </a>
      {%- endif -%}

      {%- if usp_blocks.size > 0 -%}
        <ul class="hero__usps" role="list">
          {%- for block in usp_blocks -%}
            <li class="hero__usp" {{ block.shopify_attributes }}>
              <span class="hero__usp-ic hero__usp-ic--{{ block.settings.color }}" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>
              <span class="hero__usp-text">{{ block.settings.title }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}
        {%- assign hero_desktop = section.settings.image | default: section.settings.image_mobile -%}
        {%- assign hero_mobile = section.settings.image_mobile | default: section.settings.image -%}
        <picture class="hero__pic">
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 989px)"
              srcset="{{ hero_mobile | image_url: width: 600 }} 600w, {{ hero_mobile | image_url: width: 900 }} 900w"
              sizes="100vw">
          {%- endif -%}
          <img
            src="{{ hero_desktop | image_url: width: 1100 }}"
            srcset="{{ hero_desktop | image_url: width: 700 }} 700w, {{ hero_desktop | image_url: width: 1100 }} 1100w, {{ hero_desktop | image_url: width: 1500 }} 1500w"
            sizes="(max-width: 989px) 100vw, 52vw"
            alt="{{ hero_desktop.alt | default: shop.name | escape }}"
            width="1100" height="1000" decoding="async"
            {%- if section.settings.image_priority -%} loading="eager" fetchpriority="high"{%- else -%} loading="lazy"{%- endif -%}
            class="hero__img">
        </picture>
      {%- else -%}
        <span class="hero__img hero__img--ph">{%- render 'lucide', icon: 'dog' -%}</span>
      {%- endif -%}

      {%- if section.settings.circle_text != blank -%}
        <span class="hero__circle" aria-hidden="true">
          <span class="hero__circle-heart">{%- render 'lucide', icon: 'heart' -%}</span>
          <span class="hero__circle-text">{{ section.settings.circle_text }}</span>
        </span>
      {%- endif -%}

      <span class="hero__deco hero__deco--h1" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      <span class="hero__deco hero__deco--h2" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      <span class="hero__deco hero__deco--paws" aria-hidden="true">{%- render 'lucide', icon: 'paw' -%}{%- render 'lucide', icon: 'paw' -%}</span>
      <span class="hero__deco hero__deco--spark" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>
    </div>

  </div>
</section>

{% stylesheet %}
.hero { position: relative; background: transparent; overflow: hidden; }
.hero__media::before { content: ""; position: absolute; left: 50%; bottom: 1%; transform: translateX(-50%); width: 132%; height: 70%; background: radial-gradient(56% 56% at 50% 66%, #e8f5e2 0%, rgba(232,245,226,0) 72%); z-index: 0; pointer-events: none; }

.hero__inner { position: relative; z-index: 1; max-width: var(--page-width); margin: 0 auto; padding: var(--section-pad) var(--page-margin); display: grid; grid-template-columns: 1fr 1.1fr; grid-template-areas: "intro media"; align-items: center; column-gap: 24px; }
.hero__intro { grid-area: intro; min-width: 0; }
.hero__media { grid-area: media; position: relative; min-width: 0; align-self: center; }

.hero__badge { display: inline-flex; align-items: center; gap: 9px; background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-pill); padding: 8px 16px; font-family: var(--font-body); font-size: .92rem; font-weight: 700; color: var(--color-ink); box-shadow: 0 6px 18px rgba(61,34,9,.05); margin-bottom: 20px; }
.hero__badge-icon { display: inline-flex; color: var(--color-orange); }
.hero__badge-icon svg { width: 18px; height: 18px; }

.hero__title { font-family: var(--font-heading); font-size: clamp(2.6rem, 5vw, 4.4rem); line-height: 1.02; margin: 0 0 18px; }
.hero__ln { display: block; }
.hero__ln--ink    { color: var(--color-ink); }
.hero__ln--green  { color: var(--color-green); }
.hero__ln--pink   { color: var(--color-pink); }
.hero__ln--orange { color: var(--color-orange); }
.hero__ln--yellow { color: var(--color-yellow); }
.hero__title-heart { display: inline-flex; color: var(--color-pink); vertical-align: middle; margin-left: .18em; }
.hero__title-heart svg { width: .6em; height: .6em; fill: currentColor; stroke: currentColor; }

.hero__text { font-family: var(--font-body); font-size: clamp(1.05rem, 1.4vw, 1.25rem); color: var(--color-body); line-height: 1.5; margin: 0 0 26px; max-width: 34ch; }

.hero__btn { display: inline-flex; align-items: center; gap: 10px; padding: 17px 32px; border-radius: var(--radius-pill); font-family: var(--font-heading); font-size: 1.15rem; text-decoration: none; transition: transform 160ms, box-shadow 160ms, background 160ms; }
.hero__btn--primary { background: var(--color-green); color: #fff; box-shadow: 0 12px 28px rgba(102,170,68,.28); }
.hero__btn--primary:hover { background: #5a9a3b; transform: translateY(-2px); }
.hero__btn-icon { display: inline-flex; }
.hero__btn-icon svg { width: 18px; height: 18px; }

.hero__usps { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.hero__usp { display: flex; align-items: center; gap: 10px; background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-md); padding: 12px 14px; box-shadow: 0 6px 18px rgba(61,34,9,.04); }
.hero__usp-ic { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%; }
.hero__usp-ic svg { width: 19px; height: 19px; }
.hero__usp-ic--green  { background: #e8f5e2; color: var(--color-green); }
.hero__usp-ic--orange { background: #fff0e4; color: var(--color-orange); }
.hero__usp-ic--pink   { background: #ffe0ee; color: var(--color-pink); }
.hero__usp-ic--yellow { background: #fffae0; color: #b07d00; }
.hero__usp-text { font-family: var(--font-body); font-size: .9rem; font-weight: 700; color: var(--color-ink); line-height: 1.25; }

.hero__pic { display: block; position: relative; z-index: 1; }
.hero__img { width: 100%; height: auto; max-height: 620px; object-fit: contain; display: block; position: relative; z-index: 1; }
.hero__img--ph { aspect-ratio: 1; width: 80%; margin: 0 auto; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--color-green); box-shadow: var(--shadow-card); }
.hero__img--ph svg { width: 44%; height: 44%; }

.hero__circle { position: absolute; top: 6%; left: 2%; z-index: 2; width: 120px; height: 120px; border-radius: 50%; background: var(--color-pink); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 12px; box-shadow: 0 14px 30px rgba(212,83,126,.3); text-align: center; }
.hero__circle-heart { display: inline-flex; color: #fff; }
.hero__circle-heart svg { width: 16px; height: 16px; fill: none; stroke: currentColor; }
.hero__circle-text { font-family: var(--font-heading); font-size: .82rem; line-height: 1.15; color: #fff; }

.hero__deco { position: absolute; pointer-events: none; z-index: 2; color: var(--color-pink); }
.hero__deco svg { display: block; width: 100%; height: 100%; }
.hero__deco--h1 { top: 2%; right: 6%; width: 26px; }
.hero__deco--h2 { bottom: 24%; left: 8%; width: 20px; }
.hero__deco--paws { top: 8%; right: 24%; width: 58px; height: 30px; color: var(--color-orange); opacity: .45; display: flex; gap: 6px; }
.hero__deco--spark { bottom: 12%; right: 14%; width: 30px; color: var(--color-green); }

@media (min-width: 990px) {
  .hero__inner { grid-template-columns: 1fr 1.15fr; column-gap: 12px; }
  .hero__img { max-height: 640px; }
}

@media (max-width: 989px) {
  .hero__inner { grid-template-columns: 1fr; grid-template-areas: "intro" "media"; column-gap: 0; padding: var(--section-pad-sm) var(--page-margin) 24px; }
  .hero__intro { position: relative; z-index: 3; order: 1; }
  .hero__media { order: 2; margin-top: 8px; }
  .hero__title { font-size: clamp(2.1rem, 9vw, 3rem); }
  .hero__text { max-width: 40ch; }
  .hero__btn--primary { display: flex; width: 100%; justify-content: center; }
  .hero__usps { grid-template-columns: 1fr; gap: 10px; margin-top: 24px; }
  .hero__circle { top: 2%; left: 2%; width: 100px; height: 100px; }
  .hero__circle-text { font-size: .74rem; }
  .hero__deco--paws { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge boven titel (optioneel)" },
    { "type": "header", "content": "Titel (3 regels, kleur per regel)" },
    { "type": "text", "id": "line1", "label": "Regel 1", "default": "Een feestje" },
    { "type": "select", "id": "line1_color", "label": "Kleur regel 1", "default": "ink", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "text", "id": "line2", "label": "Regel 2", "default": "in een doos" },
    { "type": "select", "id": "line2_color", "label": "Kleur regel 2", "default": "orange", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "text", "id": "line3", "label": "Regel 3", "default": "voor jouw hond" },
    { "type": "select", "id": "line3_color", "label": "Kleur regel 3", "default": "green", "options": [
      { "value": "ink", "label": "Bruin" }, { "value": "green", "label": "Groen" }, { "value": "pink", "label": "Roze" }, { "value": "orange", "label": "Oranje" }, { "value": "yellow", "label": "Geel" }
    ]},
    { "type": "header", "content": "Tekst & knop" },
    { "type": "textarea", "id": "text", "label": "Subtekst", "default": "Cadeauboxen vol speeltjes en snacks voor elke verjaardag, feestdag en elk moment." },
    { "type": "text", "id": "cta_primary_label", "label": "Knoptekst", "default": "Kies een box" },
    { "type": "url", "id": "cta_primary_url", "label": "Knop link" },
    { "type": "header", "content": "Afbeelding" },
    { "type": "image_picker", "id": "image", "label": "Hero afbeelding — desktop (hond + box)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero afbeelding — mobiel (optioneel)", "info": "Laat leeg om dezelfde afbeelding als desktop te gebruiken." },
    { "type": "text", "id": "circle_text", "label": "Roze sticker tekst", "default": "Elke box voelt als een cadeautje" },
    { "type": "checkbox", "id": "image_priority", "label": "Hoge prioriteit laden", "default": true }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP-kaartje",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Met liefde samengesteld" },
        { "type": "select", "id": "icon", "label": "Icoon", "default": "package", "options": [
          { "value": "package", "label": "Pakket" }, { "value": "gift", "label": "Cadeau" }, { "value": "leaf", "label": "Blad" }, { "value": "heart", "label": "Hart" }, { "value": "paw", "label": "Poot" }, { "value": "star", "label": "Ster" }, { "value": "shield-check", "label": "Schild" }, { "value": "sparkles", "label": "Sterretjes" }
        ]},
        { "type": "select", "id": "color", "label": "Icoon kleur", "default": "green", "options": [
          { "value": "green", "label": "Groen" }, { "value": "orange", "label": "Oranje" }, { "value": "pink", "label": "Roze" }, { "value": "yellow", "label": "Geel" }
        ]}
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "usp", "settings": { "title": "Met liefde samengesteld", "icon": "package", "color": "green" } },
        { "type": "usp", "settings": { "title": "Alleen de beste kwaliteit", "icon": "leaf", "color": "orange" } },
        { "type": "usp", "settings": { "title": "Voor blije honden en trotse baasjes", "icon": "heart", "color": "pink" } }
      ]
    }
  ]
}
{% endschema %}
