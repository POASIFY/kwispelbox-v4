{%- comment -%}
  sections/moments.liquid — Kwispelbox KB-v4
  "Voor elk moment" — gekleurde tegels met icoon + label + link, volgens docs/mockup-home.png
{%- endcomment -%}

{%- assign tiles = section.blocks | where: 'type', 'moment' -%}

<section class="mom full-width">
  <div class="mom__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mom__heading">
        {{ section.settings.heading }}
        <span class="mom__heading-heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      </h2>
    {%- endif -%}

    {%- if tiles.size > 0 -%}
      <ul class="mom__grid" role="list">
        {%- for block in tiles -%}
          <li class="mom__cell" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="mom__tile mom__tile--{{ block.settings.color }}">
            {%- else -%}
            <div class="mom__tile mom__tile--{{ block.settings.color }}">
            {%- endif -%}
              <span class="mom__deco mom__deco--tl" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>
              <span class="mom__deco mom__deco--tr" aria-hidden="true">{%- render 'lucide', icon: 'paw' -%}</span>
              <span class="mom__deco mom__deco--br" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
              <span class="mom__icon" aria-hidden="true">{%- render 'lucide', icon: block.settings.icon -%}</span>
              <span class="mom__label">
                <span class="mom__label-text">{{ block.settings.title }}</span>
                <span class="mom__label-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></span>
              </span>
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.mom { background: transparent; }
.mom__inner { max-width: var(--page-width); margin: 0 auto; padding: var(--section-pad-sm) var(--page-margin); }
.mom__heading { font-family: var(--font-heading); font-size: var(--fs-h2); color: var(--color-ink); margin: 0 0 22px; display: flex; align-items: center; gap: 10px; }
.mom__heading-heart { display: inline-flex; color: var(--color-pink); }
.mom__heading-heart svg { width: .7em; height: .7em; fill: none; stroke: currentColor; stroke-width: 2.4; }

.mom__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
.mom__tile { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 14px; aspect-ratio: 1 / 1.05; padding: 18px 12px 12px; border-radius: var(--radius-lg); text-decoration: none; overflow: hidden; transition: transform 160ms, box-shadow 160ms; }
.mom__tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }

.mom__tile--pink   { background: #ffe3ee; }
.mom__tile--green  { background: #e4f3d8; }
.mom__tile--yellow { background: #fdeeb8; }
.mom__tile--orange { background: #ffe1cb; }

.mom__icon { display: flex; align-items: center; justify-content: center; flex: 1; }
.mom__icon svg { width: 64px; height: 64px; stroke-width: 1.6; }
.mom__tile--pink   .mom__icon { color: #e75480; }
.mom__tile--green  .mom__icon { color: var(--color-green); }
.mom__tile--yellow .mom__icon { color: #d99a00; }
.mom__tile--orange .mom__icon { color: var(--color-orange); }

.mom__label { display: inline-flex; align-items: center; gap: 8px; background: #fff; border-radius: var(--radius-pill); padding: 7px 8px 7px 14px; box-shadow: 0 4px 12px rgba(61,34,9,.08); max-width: 100%; }
.mom__label-text { font-family: var(--font-heading); font-size: .92rem; color: var(--color-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mom__label-arrow { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--color-green); color: #fff; }
.mom__label-arrow svg { width: 13px; height: 13px; }

.mom__deco { position: absolute; pointer-events: none; opacity: .55; }
.mom__deco svg { width: 100%; height: 100%; }
.mom__deco--tl { top: 10px; left: 10px; width: 16px; color: var(--color-yellow); }
.mom__deco--tr { top: 12px; right: 10px; width: 18px; }
.mom__deco--br { bottom: 52px; right: 12px; width: 14px; }
.mom__tile--pink   .mom__deco--tr, .mom__tile--pink .mom__deco--br { color: #e75480; }
.mom__tile--green  .mom__deco--tr, .mom__tile--green .mom__deco--br { color: var(--color-green); }
.mom__tile--yellow .mom__deco--tr, .mom__tile--yellow .mom__deco--br { color: #d99a00; }
.mom__tile--orange .mom__deco--tr, .mom__tile--orange .mom__deco--br { color: var(--color-orange); }
.mom__deco--tr svg { fill: none; stroke: currentColor; stroke-width: 2; }
.mom__deco--br svg { fill: none; stroke: currentColor; stroke-width: 2.2; }

@media (max-width: 989px) {
  .mom__grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
}
@media (max-width: 600px) {
  .mom__grid { grid-template-columns: repeat(2, 1fr); }
  .mom__icon svg { width: 52px; height: 52px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Voor elk moment",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Voor elk moment" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment-tegel",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Verjaardag" },
        { "type": "select", "id": "icon", "label": "Icoon", "default": "cake", "options": [
          { "value": "cake", "label": "Taart" },
          { "value": "paw", "label": "Poot" },
          { "value": "home", "label": "Huis" },
          { "value": "bandage", "label": "Pleister" },
          { "value": "tree", "label": "Kerstboom" },
          { "value": "gift", "label": "Cadeau" },
          { "value": "heart", "label": "Hart" },
          { "value": "sun", "label": "Zon" },
          { "value": "pumpkin", "label": "Pompoen" },
          { "value": "bone", "label": "Botje" },
          { "value": "star", "label": "Ster" }
        ]},
        { "type": "select", "id": "color", "label": "Achtergrondkleur", "default": "pink", "options": [
          { "value": "pink", "label": "Roze" },
          { "value": "green", "label": "Groen" },
          { "value": "yellow", "label": "Geel" },
          { "value": "orange", "label": "Oranje" }
        ]},
        { "type": "url", "id": "link", "label": "Link (collectie of pagina)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Voor elk moment",
      "blocks": [
        { "type": "moment", "settings": { "title": "Verjaardag", "icon": "cake", "color": "pink" } },
        { "type": "moment", "settings": { "title": "Nieuwe puppy", "icon": "paw", "color": "green" } },
        { "type": "moment", "settings": { "title": "Adoptiedag", "icon": "home", "color": "yellow" } },
        { "type": "moment", "settings": { "title": "Beterschap", "icon": "bandage", "color": "pink" } },
        { "type": "moment", "settings": { "title": "Kerst", "icon": "tree", "color": "green" } },
        { "type": "moment", "settings": { "title": "Bedankt", "icon": "gift", "color": "orange" } }
      ]
    }
  ]
}
{% endschema %}
