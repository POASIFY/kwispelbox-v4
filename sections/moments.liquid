{%- comment -%}
  sections/moments.liquid — Kwispelbox KB-v4
  "Voor elk moment" — pasteltegels met chunky sticker-illustratie, titel op de tegel + rond pijltje.
  Volgens docs/mockup-home.png.
{%- endcomment -%}

{%- assign tiles = section.blocks | where: 'type', 'moment' -%}

<section class="mom full-width">
  <div class="mom__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mom__heading">
        {{ section.settings.heading }}
        <span class="mom__heading-heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
      </h2>
    {%- endif -%}

    {%- if tiles.size > 0 -%}
      <ul class="mom__grid" role="list">
        {%- for block in tiles -%}
          <li class="mom__cell" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="mom__tile mom__tile--{{ block.settings.color }}">
            {%- else -%}
            <div class="mom__tile mom__tile--{{ block.settings.color }}">
            {%- endif -%}
              <span class="mom__deco mom__deco--tl" aria-hidden="true">{%- render 'lucide', icon: 'sparkles' -%}</span>
              <span class="mom__deco mom__deco--tr" aria-hidden="true">{%- render 'lucide', icon: 'paw' -%}</span>
              <span class="mom__ill" aria-hidden="true">{%- render 'moment-sticker', icon: block.settings.icon -%}</span>
              <span class="mom__foot">
                <span class="mom__title">{{ block.settings.title }}</span>
                <span class="mom__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></span>
              </span>
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.mom { background: transparent; }
.mom__inner { max-width: var(--page-width); margin: 0 auto; padding: clamp(20px, 3vw, 36px) var(--page-margin) var(--section-pad-sm); }
.mom__heading { font-family: var(--font-heading); font-size: var(--fs-h2); color: var(--color-ink); margin: 0 0 20px; display: flex; align-items: center; gap: 10px; }
.mom__heading-heart { display: inline-flex; color: var(--color-pink); }
.mom__heading-heart svg { width: .7em; height: .7em; fill: none; stroke: currentColor; stroke-width: 2.4; }

.mom__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
.mom__tile { position: relative; display: flex; flex-direction: column; aspect-ratio: 1 / 0.92; padding: 16px 16px 14px; border-radius: var(--radius-lg); text-decoration: none; overflow: hidden; transition: transform 160ms, box-shadow 160ms; }
.mom__tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }

.mom__tile--pink   { background: #ffe3ee; }
.mom__tile--green  { background: #e4f3d8; }
.mom__tile--yellow { background: #fdeeb8; }
.mom__tile--orange { background: #ffe1cb; }

.mom__ill { flex: 1; display: flex; align-items: center; justify-content: center; }
.mom__ill .mom-sticker { width: 78px; height: 78px; }
.mom__ill .lucide { width: 60px; height: 60px; color: var(--color-ink); }

.mom__foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.mom__title { font-family: var(--font-heading); font-size: 1.02rem; color: var(--color-ink); line-height: 1.05; }
.mom__arrow { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: #fff; color: var(--color-ink); box-shadow: 0 2px 6px rgba(61,34,9,.12); }
.mom__arrow svg { width: 13px; height: 13px; }

.mom__deco { position: absolute; pointer-events: none; opacity: .5; }
.mom__deco svg { width: 100%; height: 100%; }
.mom__deco--tl { top: 10px; left: 11px; width: 15px; color: var(--color-yellow); }
.mom__deco--tr { top: 12px; right: 11px; width: 17px; }
.mom__tile--pink   .mom__deco--tr { color: #e75480; }
.mom__tile--green  .mom__deco--tr { color: var(--color-green); }
.mom__tile--yellow .mom__deco--tr { color: #d99a00; }
.mom__tile--orange .mom__deco--tr { color: var(--color-orange); }
.mom__deco--tr svg { fill: none; stroke: currentColor; stroke-width: 2; }

@media (max-width: 989px) {
  .mom__grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
}
@media (max-width: 600px) {
  .mom__grid { grid-template-columns: repeat(2, 1fr); }
  .mom__ill .mom-sticker { width: 66px; height: 66px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Voor elk moment",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Voor elk moment" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment-tegel",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Verjaardag" },
        { "type": "select", "id": "icon", "label": "Sticker", "default": "cake", "options": [
          { "value": "cake", "label": "Taart (verjaardag)" },
          { "value": "paw", "label": "Poot (puppy)" },
          { "value": "home", "label": "Huis (adoptie)" },
          { "value": "bandage", "label": "Pleister (beterschap)" },
          { "value": "tree", "label": "Kerstboom" },
          { "value": "gift", "label": "Cadeau (bedankt)" }
        ]},
        { "type": "select", "id": "color", "label": "Achtergrondkleur", "default": "pink", "options": [
          { "value": "pink", "label": "Roze" },
          { "value": "green", "label": "Groen" },
          { "value": "yellow", "label": "Geel" },
          { "value": "orange", "label": "Oranje" }
        ]},
        { "type": "url", "id": "link", "label": "Link (collectie of pagina)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Voor elk moment",
      "blocks": [
        { "type": "moment", "settings": { "title": "Verjaardag", "icon": "cake", "color": "pink" } },
        { "type": "moment", "settings": { "title": "Nieuwe puppy", "icon": "paw", "color": "green" } },
        { "type": "moment", "settings": { "title": "Adoptiedag", "icon": "home", "color": "yellow" } },
        { "type": "moment", "settings": { "title": "Beterschap", "icon": "bandage", "color": "pink" } },
        { "type": "moment", "settings": { "title": "Kerst", "icon": "tree", "color": "green" } },
        { "type": "moment", "settings": { "title": "Bedankt", "icon": "gift", "color": "orange" } }
      ]
    }
  ]
}
{% endschema %}
