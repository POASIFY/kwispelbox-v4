{%- comment -%}
  sections/community-ecosystem-page.liquid — Kwispelbox KB-v4 · FAMILY E (Community / Ecosystem)
  ------------------------------------------------------------------------------------------------
  Eén herbruikbare design-family voor: Partners, Zakelijk bestellen, Community en (optioneel)
  Kwispelclub. Prefix: `ce__` / `ce-`.

  Opbouw: een platte bloklijst die in editor-volgorde rendert. Opeenvolgende blokken van hetzelfde
  "type-familie" worden automatisch gegroepeerd in één grid/rij (run-grouping), zodat elke pagina
  een eigen compositie kan maken ZONDER dat elke pagina dezelfde blokken hoeft te gebruiken.
  Het renderen van één blok staat in snippets/ce-block.liquid.

  GEEN loyalty-backend, geen punten, geen account-dashboard, geen referral-engine. Formulieren
  gebruiken Shopify's native {% form 'contact' %} (mailt naar het winkel-e-mailadres).
{%- endcomment -%}

{%- liquid
  assign w = section.settings.max_width
  assign bg = section.settings.bg
-%}

<section class="ce ce--bg-{{ bg }} full-width" data-width="{{ w }}">
  {%- if section.settings.show_decorations -%}
    <div class="ce__deco" aria-hidden="true">
      <span class="ce__deco-item ce__deco--paw">{%- render 'kb-icon', icon: 'paw' -%}</span>
      <span class="ce__deco-item ce__deco--heart">{%- render 'kb-icon', icon: 'heart' -%}</span>
      <span class="ce__deco-item ce__deco--bone">{%- render 'kb-icon', icon: 'bone' -%}</span>
    </div>
  {%- endif -%}

  <div class="ce__inner ce__inner--{{ w }}">
    <div class="ce__flow">
      {%- comment -%}
        Run-consume grouping: zodra een "grid-type" blok een reeks start, renderen we de wrapper +
        alle opeenvolgende blokken van dezelfde groep + de sluit-tag in één tak (statisch
        gebalanceerd → geen UnclosedHTMLElement). Verbruikte blokken worden overgeslagen via skip_to.
      {%- endcomment -%}
      {%- assign skip_to = 0 -%}
      {%- for block in section.blocks -%}
        {%- unless forloop.index0 < skip_to -%}
          {%- assign t = block.type -%}
          {%- assign gk = 'solo' -%}
          {%- if t == 'card' -%}{%- assign gk = 'values' -%}
          {%- elsif t == 'partner' -%}{%- assign gk = 'tiles' -%}
          {%- elsif t == 'usecase' -%}{%- assign gk = 'usecases' -%}
          {%- elsif t == 'step' -%}{%- assign gk = 'steps' -%}
          {%- elsif t == 'gallery_item' -%}{%- assign gk = 'gallery' -%}
          {%- elsif t == 'chip' -%}{%- assign gk = 'chips' -%}
          {%- elsif t == 'faq' -%}{%- assign gk = 'faqs' -%}
          {%- elsif t == 'linkrow' -%}{%- assign gk = 'links' -%}
          {%- endif -%}

          {%- if gk == 'solo' -%}
            {%- render 'ce-block', block: block -%}
          {%- else -%}
            {%- comment -%} bepaal lengte van de reeks vanaf hier {%- endcomment -%}
            {%- assign run_len = 0 -%}
            {%- for b2 in section.blocks offset: forloop.index0 -%}
              {%- assign t2 = b2.type -%}
              {%- assign gk2 = 'solo' -%}
              {%- if t2 == 'card' -%}{%- assign gk2 = 'values' -%}
              {%- elsif t2 == 'partner' -%}{%- assign gk2 = 'tiles' -%}
              {%- elsif t2 == 'usecase' -%}{%- assign gk2 = 'usecases' -%}
              {%- elsif t2 == 'step' -%}{%- assign gk2 = 'steps' -%}
              {%- elsif t2 == 'gallery_item' -%}{%- assign gk2 = 'gallery' -%}
              {%- elsif t2 == 'chip' -%}{%- assign gk2 = 'chips' -%}
              {%- elsif t2 == 'faq' -%}{%- assign gk2 = 'faqs' -%}
              {%- elsif t2 == 'linkrow' -%}{%- assign gk2 = 'links' -%}
              {%- endif -%}
              {%- if gk2 == gk -%}{%- assign run_len = run_len | plus: 1 -%}{%- else -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- assign skip_to = forloop.index0 | plus: run_len -%}

            {%- case gk -%}
              {%- when 'values' -%}
                <div class="ce__values">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </div>
              {%- when 'tiles' -%}
                <div class="ce__tiles">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </div>
              {%- when 'usecases' -%}
                <div class="ce__usecases">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </div>
              {%- when 'steps' -%}
                <ol class="ce__steps">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </ol>
              {%- when 'gallery' -%}
                <div class="ce__gallery">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </div>
              {%- when 'chips' -%}
                <div class="ce__chips">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </div>
              {%- when 'faqs' -%}
                <div class="ce__faqs">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </div>
              {%- when 'links' -%}
                <div class="ce__links">
                  {%- for b3 in section.blocks offset: forloop.index0 limit: run_len -%}{%- render 'ce-block', block: b3 -%}{%- endfor -%}
                </div>
            {%- endcase -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <p class="ce-intro ce-intro--center">Voeg blokken toe in de editor om deze pagina te vullen.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* ══ FAMILY E · Community / Ecosystem ══════════════════════════════════════ */
/* Eigen karakter t.o.v. A/B/C/D: zachte roze+groene kleurvlakken als atmosfeer,
   editorial tegels i.p.v. witte-dozen-stack, luchtige stappen, rustige links. */
.ce { position: relative; padding: var(--section-pad) 0; overflow: hidden; }
.ce--bg-transparent { background: transparent; }
.ce--bg-cream { background: var(--color-cream); }
/* Zachte merk-wash die Family E meteen herkenbaar maakt (subtiel, achter alles) */
.ce::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(52% 42% at 10% -4%, rgba(231, 84, 128, .08), transparent 70%),
    radial-gradient(48% 40% at 104% 22%, rgba(102, 170, 68, .08), transparent 70%),
    radial-gradient(42% 38% at 92% 104%, rgba(247, 160, 72, .06), transparent 72%); }
.ce__inner { position: relative; z-index: 1; margin: 0 auto; padding: 0 var(--page-margin); }
.ce__inner--narrow { max-width: 1060px; }
.ce__inner--wide { max-width: var(--page-width); }
.ce__flow { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 80px); }

/* Accent-systeem (per blok via data-accent) */
.ce-hero, .ce-split, .ce-card, .ce-step, .ce-chip, .ce-link, .ce-cta { --c: var(--color-green); --c-soft: #eef7e8; }
[data-accent="green"]  { --c: var(--color-green);  --c-soft: #eef7e8; }
[data-accent="pink"]   { --c: var(--color-pink);   --c-soft: #fdeaf2; }
[data-accent="orange"] { --c: var(--color-orange); --c-soft: #fdf0e2; }
[data-accent="yellow"] { --c: #d99100;             --c-soft: #fdf6e0; }
[data-accent="cream"]  { --c: var(--color-ink);    --c-soft: var(--color-cream); }

/* Decoratie — speelse zwevende merkvormen */
.ce__deco { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.ce__deco-item { position: absolute; display: block; opacity: .55; }
.ce__deco-item svg { width: 100%; height: 100%; }
.ce__deco--paw   { top: 30px;  left: 3%;  width: 34px; height: 34px; color: var(--color-green); transform: rotate(-14deg); }
.ce__deco--heart { top: 54px;  right: 4%; width: 28px; height: 28px; color: var(--color-pink); }
.ce__deco--bone  { bottom: 36px; left: 6%; width: 32px; height: 32px; color: var(--color-orange); opacity: .4; transform: rotate(18deg); }

/* Eyebrow */
.ce-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-body); font-size: var(--fs-eyebrow); font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--c, var(--color-pink)); margin-bottom: 12px; }
.ce-eyebrow__icon { display: inline-flex; }
.ce-eyebrow__icon svg { width: 16px; height: 16px; }

/* Knoppen */
.ce-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 28px; border-radius: var(--radius-pill); font-family: var(--font-heading); font-size: 1.05rem; letter-spacing: var(--ls-button); text-decoration: none; border: 2px solid transparent; cursor: pointer; transition: filter 160ms, transform 160ms, background 160ms, color 160ms; }
.ce-btn--solid { background: var(--color-green); color: #fff; }
.ce-btn--solid:hover { filter: brightness(1.05); transform: translateY(-1px); }
.ce-btn--ghost { background: #fff; color: var(--color-ink); border-color: var(--color-line); }
.ce-btn--ghost:hover { border-color: var(--color-green); color: var(--color-green); transform: translateY(-1px); }
.ce-btn__paw svg { width: 19px; height: 19px; }

/* ── HERO ── */
.ce-hero { position: relative; }
.ce-hero--center { text-align: center; max-width: 720px; margin: 0 auto; padding: clamp(14px, 3vw, 34px) 0 clamp(6px, 2vw, 18px); }
.ce-hero--center .ce-hero__actions { justify-content: center; }
/* Zachte radiale gloed achter de gecentreerde hero → editorial, geen lege beeld-box */
.ce-hero--center::before { content: ""; position: absolute; z-index: -1; left: 50%; top: 42%; transform: translate(-50%, -50%);
  width: min(680px, 108%); height: 118%;
  background: radial-gradient(60% 60% at 50% 40%, rgba(231, 84, 128, .10), transparent 70%); }
.ce-hero--split { display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(28px, 4.5vw, 60px); align-items: center; }
.ce-hero__text { min-width: 0; }
.ce-hero__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5.4vw, 3.5rem); line-height: 1.03; color: var(--color-ink); margin: 0 0 18px; text-wrap: balance; }
.ce-hero__intro { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.6; color: var(--color-body); margin: 0 0 28px; }
.ce-hero--center .ce-hero__intro { max-width: 58ch; margin-left: auto; margin-right: auto; }
.ce-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
.ce-hero__media { position: relative; min-width: 0; }
.ce-hero__img { width: 100%; height: auto; border-radius: var(--radius-lg); display: block; box-shadow: var(--shadow-card); }
.ce-hero__badge { position: absolute; top: -14px; right: -8px; background: var(--color-pink); color: #fff; font-family: var(--font-heading); font-size: .95rem; padding: 12px 16px; border-radius: 50%; line-height: 1.05; text-align: center; max-width: 92px; transform: rotate(8deg); box-shadow: var(--shadow-pop); }

/* ── INTRO ── */
.ce-intro { max-width: 680px; }
.ce-intro--center { text-align: center; margin: 0 auto; }
.ce-intro--left { margin: 0; }
.ce-intro--center .ce-eyebrow { justify-content: center; }
.ce-intro__title { font-family: var(--font-heading); font-size: var(--fs-h2); line-height: 1.05; color: var(--color-ink); margin: 0 0 14px; }
.ce-intro__text { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.6; color: var(--color-body); }
.ce-intro__text > :first-child { margin-top: 0; }
.ce-intro__text > :last-child { margin-bottom: 0; }

/* ── SPLIT (beeld + tekst) ── */
.ce-split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 52px); align-items: center; }
.ce-split--flip .ce-split__media { order: 2; }
.ce-split__media { min-width: 0; }
.ce-split__img { width: 100%; height: auto; border-radius: var(--radius-lg); display: block; box-shadow: var(--shadow-card); }
.ce-split__img--ph { aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; background: linear-gradient(140deg, #fff, var(--c-soft)); color: var(--c); }
.ce-split__img--ph svg { width: 64px; height: 64px; }
.ce-split__body { min-width: 0; }
.ce-split__title { font-family: var(--font-heading); font-size: clamp(1.5rem, 3.6vw, 2.3rem); line-height: 1.08; color: var(--color-ink); margin: 0 0 14px; }
.ce-split__text { font-family: var(--font-body); font-size: var(--fs-body); line-height: 1.6; color: var(--color-body); }
.ce-split__text > :first-child { margin-top: 0; }
.ce-split__list { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.ce-split__list li { display: flex; align-items: flex-start; gap: 10px; font-family: var(--font-body); font-size: var(--fs-body); color: var(--color-ink); }
.ce-split__check { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--c-soft); color: var(--c); }
.ce-split__check svg { width: 14px; height: 14px; }
.ce-split__cta { margin-top: 22px; }

/* ── KAART-BASIS (typografie, gedeeld door value/tile/usecase) ── */
.ce-card { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.ce-card__icon { display: inline-flex; align-items: center; justify-content: center; color: var(--c); }
.ce-card__icon svg { width: 26px; height: 26px; }
.ce-card__title { font-family: var(--font-heading); font-size: 1.22rem; line-height: 1.1; color: var(--color-ink); margin: 2px 0 0; }
.ce-card__text { font-family: var(--font-body); font-size: .96rem; line-height: 1.55; color: var(--color-body); margin: 0; }
.ce-card__meta { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 6px; font-family: var(--font-body); font-size: .82rem; font-weight: 700; color: var(--c); }
.ce-card__meta svg { width: 14px; height: 14px; }

/* ── WAARDE-SECTIE (card) — één gedeelde zachte compositie, geen losse witte dozen ── */
.ce__values { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  gap: clamp(22px, 3vw, 40px); padding: clamp(26px, 3.6vw, 46px) clamp(24px, 3.2vw, 44px);
  border-radius: 30px; background: linear-gradient(135deg, #fdf1f5 0%, #f6f4ec 48%, #eef7e8 100%); }
.ce__values .ce-card { gap: 12px; }
.ce__values .ce-card__icon { width: 48px; height: 48px; border-radius: 14px; background: #fff; box-shadow: 0 6px 16px rgba(61, 34, 9, .07); }
.ce__values .ce-card__title { font-size: 1.14rem; }

/* ── PARTNER-TYPES (partner) — 2×2 editorial tegels, zachte tint, weinig chrome ── */
.ce__tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.ce__tiles .ce-card--partner { position: relative; overflow: hidden; background: var(--c-soft);
  border-radius: 24px; padding: clamp(24px, 2.6vw, 32px); gap: 12px;
  transition: transform 180ms, box-shadow 180ms; }
.ce__tiles .ce-card--partner:hover { transform: translateY(-3px); box-shadow: 0 16px 34px rgba(61, 34, 9, .09); }
.ce__tiles .ce-card__icon { width: 44px; height: 44px; border-radius: 13px; background: rgba(255, 255, 255, .7); }
.ce__tiles .ce-card__icon svg { width: 24px; height: 24px; }
.ce__tiles .ce-card__title { font-size: 1.28rem; }
/* grote, zachte icoon-watermerk-vorm rechtsonder → illustratief accent */
.ce__tiles .ce-card--partner::after { content: ""; position: absolute; right: -24px; bottom: -28px;
  width: 120px; height: 120px; border-radius: 50%; background: rgba(255, 255, 255, .35); z-index: 0; }
.ce__tiles .ce-card--partner > * { position: relative; z-index: 1; }

/* ── USE-CASES (usecase) — luchtige pastel tegels ── */
.ce__usecases { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; }
.ce__usecases .ce-card--usecase { background: var(--c-soft); border-radius: 22px; padding: clamp(22px, 2.4vw, 28px); gap: 11px;
  transition: transform 180ms, box-shadow 180ms; }
.ce__usecases .ce-card--usecase:hover { transform: translateY(-3px); box-shadow: 0 16px 34px rgba(61, 34, 9, .08); }
.ce__usecases .ce-card__icon { width: 50px; height: 50px; border-radius: 15px; background: #fff; box-shadow: 0 5px 14px rgba(61, 34, 9, .06); }

/* ── STAPPEN — open & luchtig, geen dozen; grote zachte nummers ── */
.ce__steps { counter-reset: ce-step; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: clamp(22px, 3vw, 38px); }
.ce-step { counter-increment: ce-step; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.ce-step__num { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 50%; background: var(--c-soft); color: var(--c); font-family: var(--font-heading); font-size: 1.5rem; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .6); }
.ce-step__num::before { content: counter(ce-step); }
.ce-step__body { min-width: 0; }
.ce-step__title { display: block; font-family: var(--font-heading); font-size: 1.14rem; color: var(--color-ink); margin-bottom: 5px; }
.ce-step__text { display: block; font-family: var(--font-body); font-size: .95rem; line-height: 1.55; color: var(--color-body); }

/* ── GALLERY (polaroids) ── */
.ce__gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 18px; }
.ce-polaroid { margin: 0; background: #fff; padding: 12px 12px 14px; border-radius: 10px; box-shadow: var(--shadow-card); min-width: 0; }
.ce-polaroid:nth-child(3n+1) { transform: rotate(-1.6deg); }
.ce-polaroid:nth-child(3n+2) { transform: rotate(1.2deg); }
.ce-polaroid:nth-child(3n)   { transform: rotate(-.6deg); }
.ce-polaroid__img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 4px; display: block; }
.ce-polaroid__img--ph { display: flex; align-items: center; justify-content: center; background: linear-gradient(140deg, #fff, #fdeaf2); color: var(--color-pink); }
.ce-polaroid__img--ph svg { width: 40px; height: 40px; }
.ce-polaroid__cap { font-family: var(--font-heading); font-size: .95rem; color: var(--color-ink); text-align: center; padding-top: 10px; }

/* ── CHIPS ── */
.ce__chips { display: flex; flex-wrap: wrap; gap: 10px; }
.ce-chip { display: inline-flex; align-items: center; gap: 7px; background: var(--c-soft); color: var(--color-ink); font-family: var(--font-body); font-weight: 700; font-size: .92rem; padding: 9px 16px; border-radius: var(--radius-pill); }
.ce-chip__icon { display: inline-flex; color: var(--c); }
.ce-chip__icon svg { width: 16px; height: 16px; }

/* ── QUOTE ── */
.ce-quote { margin: 0 auto; background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-lg); padding: clamp(26px, 4vw, 40px); max-width: 760px; text-align: center; box-shadow: var(--shadow-card); }
.ce-quote__mark { display: inline-flex; color: var(--color-pink); margin-bottom: 10px; }
.ce-quote__mark svg { width: 34px; height: 34px; }
.ce-quote__text { font-family: var(--font-heading); font-size: clamp(1.2rem, 2.2vw, 1.6rem); font-weight: 400; line-height: 1.35; color: var(--color-ink); margin: 0; }
.ce-quote__author { font-family: var(--font-body); font-weight: 700; color: var(--color-body); margin-top: 14px; }

/* ── FAQ ── */
.ce__faqs { max-width: 820px; margin-inline: auto; width: 100%; display: flex; flex-direction: column; gap: 12px; }
.ce-faq { background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-md); overflow: hidden; }
.ce-faq__q { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 18px 20px; font-family: var(--font-heading); font-size: 1.08rem; color: var(--color-ink); }
.ce-faq__q::-webkit-details-marker { display: none; }
.ce-faq__chev { display: inline-flex; flex-shrink: 0; color: var(--color-green); transition: transform 200ms; transform: rotate(90deg); }
.ce-faq__chev svg { width: 18px; height: 18px; }
.ce-faq[open] .ce-faq__chev { transform: rotate(-90deg); }
.ce-faq__a { padding: 0 20px 20px; font-family: var(--font-body); font-size: .98rem; line-height: 1.6; color: var(--color-body); }
.ce-faq__a > :first-child { margin-top: 0; }
.ce-faq__a > :last-child { margin-bottom: 0; }

/* ── INTERNE LINKS — rustig, ondergeschikt aan de CTA erboven ── */
.ce__links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 10px; }
.ce-link { display: flex; align-items: center; gap: 13px; background: transparent; border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: 13px 16px; text-decoration: none; min-width: 0; transition: background 160ms, border-color 160ms; }
.ce-link:hover { background: var(--c-soft); border-color: transparent; }
.ce-link__icon { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; color: var(--c); background: var(--c-soft); }
.ce-link:hover .ce-link__icon { background: #fff; }
.ce-link__icon svg { width: 19px; height: 19px; }
.ce-link__body { min-width: 0; display: flex; flex-direction: column; }
.ce-link__title { font-family: var(--font-heading); font-size: 1rem; color: var(--color-ink); }
.ce-link__text { font-family: var(--font-body); font-size: .84rem; color: var(--color-muted); }
.ce-link__chev { margin-left: auto; flex-shrink: 0; display: inline-flex; color: var(--color-muted); }
.ce-link__chev svg { width: 17px; height: 17px; }

/* ── CTA ── */
.ce-cta { border-radius: 28px; padding: clamp(30px, 5vw, 54px); display: flex; align-items: center; justify-content: space-between; gap: 26px; flex-wrap: wrap; scroll-margin-top: clamp(90px, 13vw, 150px); }
.ce-cta--soft { background: var(--c-soft); }
.ce-cta--gradient { background: linear-gradient(130deg, var(--color-pink), #ff9bbb); }
.ce-cta--gradient .ce-cta__title, .ce-cta--gradient .ce-cta__text { color: #fff; }
.ce-cta--gradient .ce-btn--solid { background: #fff; color: var(--color-pink); }
.ce-cta--gradient .ce-btn--ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,.6); }
.ce-cta__body { min-width: 0; flex: 1 1 320px; }
.ce-cta__title { font-family: var(--font-heading); font-size: clamp(1.5rem, 3.2vw, 2.2rem); line-height: 1.08; color: var(--color-ink); margin: 0 0 8px; }
.ce-cta__text { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.55; color: var(--color-body); margin: 0; }
.ce-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }

/* ── FORMULIER ── */
.ce-form-wrap { max-width: 760px; margin-inline: auto; width: 100%; scroll-margin-top: clamp(90px, 13vw, 150px); }
.ce-form__heading { font-family: var(--font-heading); font-size: var(--fs-h2); line-height: 1.05; color: var(--color-ink); text-align: center; margin: 0 0 10px; }
.ce-form__lead { font-family: var(--font-body); font-size: var(--fs-lead); line-height: 1.55; color: var(--color-body); text-align: center; max-width: 560px; margin: 0 auto 26px; }
/* Branded container: zachte merk-band + roze accentrand bovenaan */
.ce-form__card { position: relative; background: linear-gradient(180deg, #ffffff 0%, #fdf7f0 100%); border: 1.5px solid var(--color-line); border-radius: 26px; padding: clamp(24px, 4vw, 38px); box-shadow: var(--shadow-card); overflow: hidden; }
.ce-form__card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, var(--color-pink), var(--color-green)); }
.ce-form { display: flex; flex-direction: column; gap: 16px; }
.ce-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.ce-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.ce-field__lbl { font-family: var(--font-body); font-size: .85rem; font-weight: 700; color: var(--color-ink); }
.ce-field__opt { font-weight: 400; color: var(--color-muted); }
.ce-field input, .ce-field select, .ce-field textarea { font-family: var(--font-body); font-size: .98rem; color: var(--color-ink); border: 1.5px solid var(--color-line); border-radius: 14px; padding: 13px 15px; background: var(--color-cream); outline: none; width: 100%; transition: border-color 160ms, background 160ms; }
.ce-field input:focus, .ce-field select:focus, .ce-field textarea:focus { border-color: var(--color-green); background: #fff; }
.ce-field textarea { resize: vertical; min-height: 104px; }
.ce-field--check { flex-direction: row; align-items: flex-start; gap: 10px; font-family: var(--font-body); font-size: .92rem; color: var(--color-body); line-height: 1.5; }
.ce-field--check input { width: 19px; height: 19px; flex-shrink: 0; margin-top: 1px; accent-color: var(--color-green); }
.ce-field--consent { font-size: .82rem; color: var(--color-muted); }
.ce-field--consent a { color: var(--color-green); text-decoration: underline; }
.ce-form__submit { align-self: flex-start; margin-top: 4px; }
.ce-form__note { font-family: var(--font-body); font-size: .8rem; color: var(--color-muted); margin: 0; }
.ce-form__errors { font-family: var(--font-body); font-size: .9rem; color: #b3261e; background: #fdecea; border-radius: 12px; padding: 12px 14px; }
.ce-form__success { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 22px 12px; }
.ce-form__success-icon { display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 50%; background: #e8f5e2; color: var(--color-green); }
.ce-form__success-icon svg { width: 27px; height: 27px; }
.ce-form__success strong { font-family: var(--font-heading); font-size: 1.3rem; color: var(--color-ink); }
.ce-form__success span { font-family: var(--font-body); color: var(--color-body); }

/* ── Tablet ── */
@media (max-width: 989px) {
  .ce-hero--split { grid-template-columns: 1fr; text-align: center; }
  .ce-hero--split .ce-hero__actions { justify-content: center; }
  .ce-hero--split .ce-hero__media { order: -1; max-width: 420px; margin: 0 auto; }
  .ce-hero__badge { right: 8px; }
}

/* ── Mobiel — compacter zonder leesbaarheid te verliezen ── */
@media (max-width: 749px) {
  .ce__flow { gap: 34px; }
  .ce-hero--center { padding: 6px 0 2px; }
  .ce-split, .ce-split--flip { grid-template-columns: 1fr; gap: 18px; }
  .ce-split--flip .ce-split__media { order: -1; }
  .ce-split__media { max-width: 460px; margin: 0 auto; }
  .ce__values { padding: 24px 20px; gap: 20px; border-radius: 24px; }
  .ce__tiles { grid-template-columns: 1fr; gap: 12px; }
  .ce__tiles .ce-card--partner { padding: 20px 20px; }
  .ce__usecases { gap: 12px; }
  .ce__usecases .ce-card--usecase { padding: 18px 18px; }
  .ce__steps { gap: 20px; }
  .ce-step { flex-direction: row; align-items: flex-start; gap: 14px; }
  .ce-step__num { width: 46px; height: 46px; font-size: 1.25rem; }
  .ce__faqs { gap: 10px; }
  .ce-faq__q { padding: 15px 16px; font-size: 1.02rem; }
  .ce-faq__a { padding: 0 16px 16px; }
  .ce-form__card { padding: 22px 18px; }
  .ce-form__row { grid-template-columns: 1fr; }
  .ce-form__submit { align-self: stretch; }
  .ce-btn { width: 100%; }
  .ce-hero__actions .ce-btn, .ce-cta__actions .ce-btn { width: 100%; }
  .ce-cta { flex-direction: column; align-items: flex-start; text-align: left; }
  .ce-cta__actions { width: 100%; }
  .ce__deco { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .ce-link, .ce-btn, .ce__tiles .ce-card--partner, .ce__usecases .ce-card--usecase { transition: none; }
  .ce-btn:hover, .ce__tiles .ce-card--partner:hover, .ce__usecases .ce-card--usecase:hover { transform: none; }
  .ce-polaroid { transform: none; }
}
{% endstylesheet %}

