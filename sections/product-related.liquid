{%- comment -%}
  sections/product-related.liquid — Kwispelbox KB-v4
  Gerelateerde boxen: max 3 andere Special Editions (huidige uitgesloten), compacte cards → PDP.
  Bron: collectie 'special-editions'. Kaartkleur uit custom.kaart_kleur met fallback-palet.
{%- endcomment -%}

{%- assign rel_coll = collections[section.settings.collection] | default: collections['special-editions'] -%}
{%- assign fb_hex = '#FFB8CD,#66AA44,#F7A048,#FFE071' | split: ',' -%}

{%- if rel_coll != blank and rel_coll.products.size > 1 -%}
  <section class="prel full-width">
    <div class="prel__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="prel__heading">{{ section.settings.heading }}<span class="prel__heading-heart" aria-hidden="true">{%- render 'kb-icon', icon: 'heart' -%}</span></h2>
      {%- endif -%}

      <ul class="prel__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for box in rel_coll.products -%}
          {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
          {%- if box.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- assign kkleur = box.metafields.custom.kaart_kleur -%}
          {%- assign idx = shown | modulo: 4 -%}
          {%- if kkleur != blank -%}{%- assign topbg = kkleur -%}{%- else -%}{%- assign topbg = fb_hex[idx] -%}{%- endif -%}
          <li class="prel-card" {{ box.shopify_attributes }}>
            <a href="{{ box.url }}" class="prel-card__media" style="background: {{ topbg }};">
              {%- if box.featured_image != blank -%}
                {{ box.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,350,500', sizes: '(max-width: 749px) 90vw, 300px', alt: box.featured_image.alt | default: box.title, class: 'prel-card__img' }}
              {%- else -%}
                <span class="prel-card__ph" aria-hidden="true">{%- render 'kb-icon', icon: 'gift' -%}</span>
              {%- endif -%}
            </a>
            <div class="prel-card__body">
              <h3 class="prel-card__title"><a href="{{ box.url }}">{{ box.title }}</a></h3>
              <div class="prel-card__meta">
                <span class="prel-card__price">vanaf {{ box.price_min | money }}</span>
                <a href="{{ box.url }}" class="prel-card__btn">Bekijk<span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a>
              </div>
            </div>
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
.prel { background: transparent; }
.prel__inner { max-width: var(--page-width); margin: 0 auto; padding: clamp(20px, 3vw, 40px) var(--page-margin) clamp(28px, 4vw, 56px); }
.prel__heading { font-family: var(--font-heading); font-size: var(--fs-h2); color: var(--color-ink); margin: 0 0 18px; display: flex; align-items: center; gap: 10px; }
.prel__heading-heart { display: inline-flex; color: var(--color-pink); }
.prel__heading-heart svg { width: .6em; height: .6em; fill: none; stroke: currentColor; stroke-width: 2.4; }

.prel__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.prel-card { display: flex; flex-direction: column; background: #fffaf2; border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 5px 16px rgba(61,34,9,.05); transition: transform 160ms, box-shadow 160ms; }
.prel-card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(61,34,9,.09); }
.prel-card__media { display: block; position: relative; aspect-ratio: 1 / 0.82; padding: 9px; }
.prel-card__img { width: 100%; height: 100%; object-fit: contain; display: block; }
.prel-card__ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.75); }
.prel-card__ph svg { width: 38%; height: 38%; }
.prel-card__body { display: flex; flex-direction: column; gap: 8px; padding: 12px 14px 14px; flex: 1; }
.prel-card__title { font-family: var(--font-heading); font-size: 1.02rem; line-height: 1.1; letter-spacing: .012em; margin: 0; }
.prel-card__title a { color: var(--color-ink); text-decoration: none; }
.prel-card__meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; }
.prel-card__price { font-family: var(--font-heading); font-size: 1rem; color: var(--color-ink); }
.prel-card__btn { display: inline-flex; align-items: center; gap: 5px; background: var(--color-green); color: #fff; font-family: var(--font-heading); font-size: .84rem; letter-spacing: var(--ls-button); padding: 7px 12px; border-radius: var(--radius-pill); text-decoration: none; transition: background 140ms, transform 140ms; }
.prel-card__btn:hover { background: #5a9a3b; transform: translateY(-1px); }
.prel-card__btn svg { width: 13px; height: 13px; }

@media (max-width: 749px) {
  .prel__grid { grid-template-columns: 1fr 1fr; gap: 12px; }
}
@media (max-width: 480px) {
  .prel-card__body { padding: 10px 11px 12px; }
  .prel-card__meta { flex-direction: column; align-items: flex-start; gap: 6px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Gerelateerde boxen",
  "tag": "section",
  "class": "section-product-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Ook leuk voor je hond" },
    { "type": "collection", "id": "collection", "label": "Collectie", "info": "Standaard: special-editions" }
  ],
  "presets": [{ "name": "Gerelateerde boxen" }]
}
{% endschema %}
