{%- comment -%}
  sections/featured-products.liquid — Kwispelbox KB-v4
  "Meest gekozen" — productkaarten uit een collectie, kaartkleur uit product-metafield
  custom.kaart_kleur (met fallback-palet). Volgens docs/mockup-home.png.
{%- endcomment -%}

{%- assign coll = section.settings.collection -%}
{%- assign fb_hex = '#FFB8CD,#66AA44,#F7A048,#FFE071' | split: ',' -%}

<section class="mg full-width">
  <div class="mg__inner">
    <div class="mg__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="mg__heading">
          {{ section.settings.heading }}
          <span class="mg__heading-heart" aria-hidden="true">{%- render 'lucide', icon: 'heart' -%}</span>
        </h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: coll.url }}" class="mg__viewall">
          {{ section.settings.link_label }}
          <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></span>
        </a>
      {%- endif -%}
    </div>

    {%- if coll != blank and coll.products.size > 0 -%}
      <ul class="mg__grid" role="list">
        {%- for product in coll.products limit: section.settings.count -%}
          {%- assign kkleur = product.metafields.custom.kaart_kleur -%}
          {%- assign idx = forloop.index0 | modulo: 4 -%}
          {%- if kkleur != blank -%}{%- assign topbg = kkleur -%}{%- else -%}{%- assign topbg = fb_hex[idx] -%}{%- endif -%}
          {%- assign kaarttekst = product.metafields.custom.kaart_tekst | default: product.description | strip_html | truncatewords: 12 -%}
          <li class="mg__cell" {{ product.shopify_attributes }}>
            <div class="mg__card">
              <a href="{{ product.url }}" class="mg__media" style="background: {{ topbg }};">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(max-width: 749px) 50vw, 300px', alt: product.featured_image.alt | default: product.title, class: 'mg__img' }}
                {%- else -%}
                  <span class="mg__img mg__img--ph">{%- render 'lucide', icon: 'gift' -%}</span>
                {%- endif -%}
              </a>
              <div class="mg__body">
                <h3 class="mg__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                {%- if kaarttekst != blank -%}<p class="mg__text">{{ kaarttekst }}</p>{%- endif -%}
                <div class="mg__meta">
                  <span class="mg__price">{{ product.price | money }}</span>
                  <div class="mg__actions">
                    <button type="button" class="mg__wish" aria-label="Voeg toe aan verlanglijst" data-wishlist-handle="{{ product.handle }}">
                      {%- render 'lucide', icon: 'heart' -%}
                    </button>
                    <a href="{{ product.url }}" class="mg__btn">
                      {{ section.settings.button_label }}
                      <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="mg__empty">Kies een collectie in de sectie-instellingen om producten te tonen.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.mg { background: transparent; }
.mg__inner { max-width: var(--page-width); margin: 0 auto; padding: clamp(14px, 2vw, 24px) var(--page-margin) var(--section-pad-sm); }
.mg__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
.mg__heading { font-family: var(--font-heading); font-size: var(--fs-h2); color: var(--color-ink); margin: 0; display: flex; align-items: center; gap: 10px; }
.mg__heading-heart { display: inline-flex; color: var(--color-pink); }
.mg__heading-heart svg { width: .7em; height: .7em; fill: none; stroke: currentColor; stroke-width: 2.4; }
.mg__viewall { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-body); font-weight: 700; font-size: .95rem; color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
.mg__viewall svg { width: 15px; height: 15px; }

.mg__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.mg__card { display: flex; flex-direction: column; height: 100%; background: #fffaf2; border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 5px 16px rgba(61,34,9,.05); transition: transform 160ms, box-shadow 160ms; }
.mg__card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(61,34,9,.09); }
.mg__media { display: block; position: relative; aspect-ratio: 1 / 0.86; padding: 9px; }
.mg__img { width: 100%; height: 100%; object-fit: contain; display: block; }
.mg__img--ph { display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.7); }
.mg__img--ph svg { width: 40%; height: 40%; }

.mg__body { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px 12px; flex: 1; }
.mg__title { font-family: var(--font-heading); font-size: 1rem; line-height: 1.1; letter-spacing: .012em; margin: 2px 0 0; }
.mg__title a { color: var(--color-ink); text-decoration: none; }
.mg__text { font-family: var(--font-body); font-size: .8rem; color: var(--color-muted); line-height: 1.4; margin: 0; }
.mg__meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 12px; }
.mg__price { font-family: var(--font-heading); font-size: 1.15rem; color: var(--color-ink); line-height: 1; }
.mg__actions { display: inline-flex; align-items: center; gap: 6px; }
.mg__wish { display: inline-flex; align-items: center; justify-content: center; width: 31px; height: 31px; border-radius: 50%; border: 1px solid var(--color-line); background: transparent; color: #e75480; cursor: pointer; transition: background 140ms, border-color 140ms; }
.mg__wish:hover { background: #ffe0ee; border-color: #ffc2da; }
.mg__wish svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
.mg__btn { display: inline-flex; align-items: center; gap: 5px; background: var(--color-green); color: #fff; font-family: var(--font-heading); font-size: .86rem; letter-spacing: var(--ls-button); padding: 8px 13px; border-radius: var(--radius-pill); text-decoration: none; transition: background 140ms, transform 140ms; }
.mg__btn:hover { background: #5a9a3b; transform: translateY(-1px); }
.mg__btn svg { width: 13px; height: 13px; }
.mg__empty { font-family: var(--font-body); color: var(--color-muted); }

@media (max-width: 989px) and (min-width: 750px) { .mg__grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
/* Mobiel: horizontale scroll-snap-carousel (~1.25 kaart zichtbaar, volgende kaart peekt). */
@media (max-width: 749px) {
  .mg__head { flex-direction: column; align-items: flex-start; gap: 6px; }
  .mg__grid {
    display: flex; grid-template-columns: none; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none;
    margin: 0 calc(-1 * var(--page-margin)); padding: 4px var(--page-margin) 14px;
  }
  .mg__grid::-webkit-scrollbar { display: none; }
  .mg__cell { flex: 0 0 78%; scroll-snap-align: start; }
  .mg__btn { padding: 9px 14px; font-size: .9rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Meest gekozen",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Meest gekozen" },
    { "type": "collection", "id": "collection", "label": "Collectie" },
    { "type": "range", "id": "count", "label": "Aantal producten", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link rechtsboven", "default": "Bekijk alle boxen" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "text", "id": "button_label", "label": "Knoptekst per kaart", "default": "Bekijk" },
    { "type": "paragraph", "content": "Kaartkleur komt uit product-metafield custom.kaart_kleur; korte tekst uit custom.kaart_tekst (anders de productomschrijving)." }
  ],
  "presets": [
    { "name": "Meest gekozen", "settings": { "collection": "meest-gekozen" } }
  ]
}
{% endschema %}
