{%- comment -%}
  sections/product-extras.liquid — Kwispelbox KB-v4
  Contextuele cross-sell: compacte cadeau-extra's met snelle "+"-toevoeging (additief, geen 2e checkout).
  Occasion-gefilterd, alleen beschikbare producten, max 3. Bron: collectie 'cadeau-extras'.
{%- endcomment -%}

{%- assign extras_coll = collections[section.settings.collection] | default: collections['cadeau-extras'] -%}
{%- assign occ = product.metafields.custom.occasion.value | first | default: '' -%}

{%- if extras_coll != blank and extras_coll.products.size > 0 -%}
  <section class="pex full-width">
    <div class="pex__inner">
      <div class="pex__head">
        <span class="pex__icon" aria-hidden="true">{%- render 'kb-icon', icon: 'gift' -%}</span>
        <div>
          {%- if section.settings.heading != blank -%}<h2 class="pex__heading">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p class="pex__sub">{{ section.settings.text }}</p>{%- endif -%}
        </div>
      </div>

      <ul class="pex__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for extra in extras_coll.products -%}
          {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
          {%- unless extra.available -%}{%- continue -%}{%- endunless -%}
          {%- comment -%} Taartje is verjaardag-specifiek; bij andere gelegenheden overslaan. {%- endcomment -%}
          {%- if occ != 'verjaardag' and extra.handle contains 'taartje' -%}{%- continue -%}{%- endif -%}
          {%- assign pal = 'pink,green,orange' | split: ',' -%}
          {%- assign tint = pal[shown] -%}
          <li class="pex-card" {{ extra.shopify_attributes }}>
            <a href="{{ extra.url }}" class="pex-card__media pex-card__media--{{ tint }}">
              {%- if extra.featured_image != blank -%}
                {{ extra.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,120,160', sizes: '72px', alt: extra.featured_image.alt | default: extra.title, class: 'pex-card__img' }}
              {%- else -%}
                <span class="pex-card__ph" aria-hidden="true">{%- render 'kb-icon', icon: 'gift' -%}</span>
              {%- endif -%}
            </a>
            <div class="pex-card__body">
              <a href="{{ extra.url }}" class="pex-card__title">{{ extra.title }}</a>
              <span class="pex-card__price">{{ extra.price | money }}</span>
            </div>
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pex-card__form" data-pex-form>
              <input type="hidden" name="id" value="{{ extra.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="pex-card__add" aria-label="Voeg {{ extra.title | escape }} toe aan je winkelmand" data-pex-add>
                <span class="pex-card__add-plus" aria-hidden="true">+</span>
                <span class="pex-card__add-ok" aria-hidden="true">{%- render 'kb-icon', icon: 'check' -%}</span>
              </button>
            </form>
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
.pex { background: transparent; }
.pex__inner { max-width: var(--page-width); margin: 0 auto; padding: clamp(20px, 3vw, 34px) var(--page-margin); }
.pex__head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.pex__icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: #fff0f5; color: var(--color-pink); }
.pex__icon svg { width: 20px; height: 20px; }
.pex__heading { font-family: var(--font-heading); font-size: clamp(1.4rem, 2.4vw, 1.9rem); color: var(--color-ink); margin: 0; }
.pex__sub { font-family: var(--font-body); font-size: .92rem; color: var(--color-muted); margin: 2px 0 0; }

.pex__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.pex-card { display: flex; align-items: center; gap: 12px; background: #fffaf2; border-radius: var(--radius-lg); padding: 10px 12px; box-shadow: 0 4px 14px rgba(61,34,9,.05); }
.pex-card__media { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 56px; height: 56px; border-radius: 14px; overflow: hidden; }
.pex-card__media--pink { background: #f7a8c4; }
.pex-card__media--green { background: #a7d18a; }
.pex-card__media--orange { background: #f4b06a; }
.pex-card__img { width: 100%; height: 100%; object-fit: cover; }
.pex-card__ph { display: inline-flex; color: rgba(255,255,255,.9); }
.pex-card__ph svg { width: 26px; height: 26px; }
.pex-card__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.pex-card__title { font-family: var(--font-heading); font-size: .95rem; line-height: 1.1; color: var(--color-ink); text-decoration: none; overflow-wrap: anywhere; }
.pex-card__title:hover { text-decoration: underline; }
.pex-card__price { font-family: var(--font-body); font-size: .86rem; font-weight: 700; color: var(--color-body); }
.pex-card__form { margin: 0; flex-shrink: 0; }
.pex-card__add { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; border: none; background: var(--color-green); color: #fff; cursor: pointer; transition: background 140ms, transform 140ms; }
.pex-card__add:hover { background: #5a9a3b; transform: translateY(-1px); }
.pex-card__add-plus { font-size: 1.5rem; line-height: 1; }
.pex-card__add-ok { display: none; }
.pex-card__add-ok svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 3; }
.pex-card__add.is-added { background: var(--color-green); }
.pex-card__add.is-added .pex-card__add-plus { display: none; }
.pex-card__add.is-added .pex-card__add-ok { display: inline-flex; }

/* Mobiel: compacte verticale-card carousel met horizontale swipe (~1.25 kaart zichtbaar, max 3). */
@media (max-width: 749px) {
  .pex__grid {
    display: flex; grid-template-columns: none; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none;
    margin: 0 calc(-1 * var(--page-margin)); padding: 4px var(--page-margin) 12px;
  }
  .pex__grid::-webkit-scrollbar { display: none; }
  .pex-card { position: relative; flex: 0 0 78%; scroll-snap-align: start; flex-direction: column; align-items: stretch; gap: 8px; padding: 10px; }
  .pex-card__media { width: 100%; height: auto; aspect-ratio: 1 / 0.85; border-radius: 14px; }
  .pex-card__ph svg { width: 34px; height: 34px; }
  .pex-card__body { min-width: 0; gap: 2px; }
  .pex-card__form { position: absolute; top: 16px; right: 16px; margin: 0; }
  .pex-card__add { width: 40px; height: 40px; box-shadow: 0 4px 12px rgba(61,34,9,.18); }
}
{% endstylesheet %}

{% javascript %}
(function () {
  document.querySelectorAll('[data-pex-form]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      if (!window.fetch) return; // fallback: normale POST
      e.preventDefault();
      var btn = form.querySelector('[data-pex-add]');
      var body = new FormData(form);
      fetch('/cart/add.js', { method: 'POST', body: body, headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function () {
          if (btn) { btn.classList.add('is-added'); setTimeout(function () { btn.classList.remove('is-added'); }, 1600); }
          return fetch('/cart.js', { headers: { 'Accept': 'application/json' } });
        })
        .then(function (r) { return r ? r.json() : null; })
        .then(function (cart) {
          if (!cart) return;
          document.querySelectorAll('.site-header__cart-count').forEach(function (el) { el.textContent = cart.item_count; });
        })
        .catch(function () { form.submit(); });
    });
  });
}());
{% endjavascript %}

{% schema %}
{
  "name": "Cadeau-extra's",
  "tag": "section",
  "class": "section-product-extras",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Maak er een écht cadeau van" },
    { "type": "text", "id": "text", "label": "Subtekst", "default": "Voeg een klein extraatje toe — met één tik." },
    { "type": "collection", "id": "collection", "label": "Collectie met extra's", "info": "Standaard: cadeau-extras" }
  ],
  "presets": [{ "name": "Cadeau-extra's" }]
}
{% endschema %}
